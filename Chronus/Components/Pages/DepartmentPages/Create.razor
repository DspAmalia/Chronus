@page "/departments/create"
@using Microsoft.EntityFrameworkCore
@using Chronus.Models.MainModels
@inject IDbContextFactory<Chronus.Data.ChronusDbContext> DbFactory
@inject NavigationManager NavigationManager
@rendermode InteractiveServer

<PageTitle>Chronus - Create Department</PageTitle>

<div class="container-fluid mt-4">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <!-- Header Navigare -->
            <div class="mb-3">
                <a href="/departments" class="text-decoration-none text-muted small">
                    <i class="bi bi-arrow-left me-1"></i> Back to Departments List
                </a>
            </div>

            <!-- Card Principal -->
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-header bg-white py-3 border-bottom-0">
                    <div class="d-flex align-items-center">
                        <div class="rounded-circle p-3 me-3 d-flex align-items-center justify-content-center"
                             style="background-color: #eef2ff; color: #4f46e5; width: 48px; height: 48px;">
                            <i class="bi bi-building-add fs-4"></i>
                        </div>
                        <div>
                            <h4 class="mb-0 fw-bold text-dark">Create New Department</h4>
                            <p class="text-muted small mb-0">Add a new operational department to your organizational structure.</p>
                        </div>
                    </div>
                </div>

                <div class="card-body p-4">
                    <EditForm Model="Department" OnValidSubmit="AddDepartment">
                        <DataAnnotationsValidator />
                        <ValidationSummary class="alert alert-danger p-2 mb-3 small" role="alert" />

                        <!-- Name Input -->
                        <div class="mb-3">
                            <label for="name" class="form-label fw-semibold">Department Name <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-building"></i></span>
                                <InputText id="name" @bind-Value="Department.Name" class="form-control border-start-0 ps-0 shadow-none" placeholder="e.g. Engineering, Human Resources, Marketing" />
                            </div>
                            <ValidationMessage For="() => Department.Name" class="text-danger small mt-1" />
                        </div>

                        <!-- Description Input -->
                        <div class="mb-4">
                            <label for="description" class="form-label fw-semibold">Description</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-card-text"></i></span>
                                <InputText id="description" @bind-Value="Department.Description" class="form-control border-start-0 ps-0 shadow-none" placeholder="Brief overview of department scope..." />
                            </div>
                            <ValidationMessage For="() => Department.Description" class="text-danger small mt-1" />
                        </div>

                        <!-- Actions -->
                        <div class="d-flex justify-content-between align-items-center pt-3 border-top">
                            <a href="/departments" class="btn btn-light border px-4">Cancel</a>
                            <button type="submit" class="btn text-white px-4 d-flex align-items-center gap-2" style="background-color: #4f46e5; border: none;" disabled="@isSubmitting">
                                @if (isSubmitting)
                                {
                                    <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                                    <span>Saving...</span>
                                }
                                else
                                {
                                    <i class="bi bi-check-circle-fill"></i>
                                    <span>Save Department</span>
                                }
                            </button>
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private Department Department { get; set; } = new();
    private bool isSubmitting = false;

    private async Task AddDepartment()
    {
        if (isSubmitting) return;
        isSubmitting = true;

        try
        {
            using var context = await DbFactory.CreateDbContextAsync();
            context.Departments.Add(Department);
            await context.SaveChangesAsync();

            NavigationManager.NavigateTo("/departments");
        }
        finally
        {
            isSubmitting = false;
        }
    }
}