@page "/departments/edit"
@using Microsoft.EntityFrameworkCore
@using Chronus.Models.MainModels
@inject IDbContextFactory<Chronus.Data.ChronusDbContext> DbFactory
@inject NavigationManager NavigationManager
@rendermode InteractiveServer

<PageTitle>Chronus - Edit Department</PageTitle>

<div class="container-fluid mt-4">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <!-- Header Navigare -->
            <div class="mb-3">
                <a href="/departments" class="text-decoration-none text-muted small">
                    <i class="bi bi-arrow-left me-1"></i> Back to Departments List
                </a>
            </div>

            <!-- Card Principal -->
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-header bg-white py-3 border-bottom-0">
                    <div class="d-flex align-items-center">
                        <div class="rounded-circle p-3 me-3 d-flex align-items-center justify-content-center"
                             style="background-color: #fef3c7; color: #d97706; width: 48px; height: 48px;">
                            <i class="bi bi-pencil-square fs-4"></i>
                        </div>
                        <div>
                            <h4 class="mb-0 fw-bold text-dark">Edit Department</h4>
                            <p class="text-muted small mb-0">Update department title and operational scope description.</p>
                        </div>
                    </div>
                </div>

                <div class="card-body p-4">
                    @if (Department is null)
                    {
                        <div class="d-flex justify-content-center py-4">
                            <div class="spinner-border text-indigo" role="status" style="color: #4f46e5;">
                                <span class="visually-hidden">Loading...</span>
                            </div>
                        </div>
                    }
                    else
                    {
                        <EditForm Model="Department" OnValidSubmit="UpdateDepartment">
                            <DataAnnotationsValidator />
                            <ValidationSummary class="alert alert-danger p-2 mb-3 small" role="alert" />

                            <!-- Name Input -->
                            <div class="mb-3">
                                <label for="name" class="form-label fw-semibold">Department Name <span class="text-danger">*</span></label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-building"></i></span>
                                    <InputText id="name" @bind-Value="Department.Name" class="form-control border-start-0 ps-0 shadow-none" placeholder="e.g. Engineering, Finance" />
                                </div>
                                <ValidationMessage For="() => Department.Name" class="text-danger small mt-1" />
                            </div>

                            <!-- Description Input -->
                            <div class="mb-4">
                                <label for="description" class="form-label fw-semibold">Description</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-card-text"></i></span>
                                    <InputText id="description" @bind-Value="Department.Description" class="form-control border-start-0 ps-0 shadow-none" placeholder="Short summary of department responsibilities..." />
                                </div>
                                <ValidationMessage For="() => Department.Description" class="text-danger small mt-1" />
                            </div>

                            <!-- Actions -->
                            <div class="d-flex justify-content-between align-items-center pt-3 border-top">
                                <a href="/departments" class="btn btn-light border px-4">Cancel</a>
                                <button type="submit" class="btn btn-warning px-4 d-flex align-items-center gap-2" disabled="@isSubmitting">
                                    @if (isSubmitting)
                                    {
                                        <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                                        <span>Saving Changes...</span>
                                    }
                                    else
                                    {
                                        <i class="bi bi-check-lg"></i>
                                        <span>Update Department</span>
                                    }
                                </button>
                            </div>
                        </EditForm>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    [SupplyParameterFromQuery]
    private Guid Id { get; set; }

    private Department? Department { get; set; }
    private bool isSubmitting = false;

    protected override async Task OnInitializedAsync()
    {
        using var context = await DbFactory.CreateDbContextAsync();
        Department = await context.Departments.FirstOrDefaultAsync(m => m.Id == Id);

        if (Department is null)
        {
            NavigationManager.NavigateTo("/departments");
        }
    }

    private async Task UpdateDepartment()
    {
        if (Department is null || isSubmitting) return;
        isSubmitting = true;

        try
        {
            using var context = await DbFactory.CreateDbContextAsync();
            context.Attach(Department).State = EntityState.Modified;

            try
            {
                await context.SaveChangesAsync();
                NavigationManager.NavigateTo("/departments");
            }
            catch (DbUpdateConcurrencyException)
            {
                if (!await DepartmentExistsAsync(Department.Id))
                {
                    NavigationManager.NavigateTo("/departments");
                }
                else
                {
                    throw;
                }
            }
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private async Task<bool> DepartmentExistsAsync(Guid id)
    {
        using var context = await DbFactory.CreateDbContextAsync();
        return await context.Departments.AnyAsync(e => e.Id == id);
    }
}