@page "/departments/details"
@using Microsoft.EntityFrameworkCore
@using Chronus.Models.MainModels
@inject IDbContextFactory<Chronus.Data.ChronusDbContext> DbFactory
@inject NavigationManager NavigationManager
@rendermode InteractiveServer

<PageTitle>Chronus - Department Details</PageTitle>

<div class="container-fluid mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <!-- Header Navigare -->
            <div class="mb-3">
                <a href="/departments" class="text-decoration-none text-muted small">
                    <i class="bi bi-arrow-left me-1"></i> Back to Departments List
                </a>
            </div>

            <!-- Card Principal -->
            <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
                <div class="card-header bg-white py-3 border-bottom-0">
                    <div class="d-flex align-items-center justify-content-between">
                        <div class="d-flex align-items-center">
                            <div class="rounded-circle p-3 me-3 d-flex align-items-center justify-content-center"
                                 style="background-color: #eef2ff; color: #4f46e5; width: 48px; height: 48px;">
                                <i class="bi bi-building fs-4"></i>
                            </div>
                            <div>
                                <h4 class="mb-0 fw-bold text-dark">Department Details</h4>
                                <p class="text-muted small mb-0">Overview of department structure and assigned members.</p>
                            </div>
                        </div>
                        @if (department is not null)
                        {
                            <a href="@($"/departments/edit?id={department.Id}")" class="btn btn-outline-primary btn-sm d-flex align-items-center gap-1">
                                <i class="bi bi-pencil"></i> Edit Department
                            </a>
                        }
                    </div>
                </div>

                <div class="card-body p-4">
                    @if (department is null)
                    {
                        <div class="d-flex justify-content-center py-4">
                            <div class="spinner-border text-indigo" role="status" style="color: #4f46e5;">
                                <span class="visually-hidden">Loading...</span>
                            </div>
                        </div>
                    }
                    else
                    {
                        <!-- Date Generale -->
                        <div class="bg-light p-3 rounded-3 mb-4 border">
                            <div class="row mb-3 align-items-center">
                                <div class="col-sm-4 text-muted fw-semibold">Department Name:</div>
                                <div class="col-sm-8 fs-5 fw-bold text-dark">
                                    @department.Name
                                    <span class="badge bg-secondary fs-6 ms-2">ID: @department.Id.ToString().Substring(0, 8)...</span>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-sm-4 text-muted fw-semibold">Description:</div>
                                <div class="col-sm-8 text-secondary">
                                    @(string.IsNullOrWhiteSpace(department.Description) ? "No description provided." : department.Description)
                                </div>
                            </div>
                        </div>

                        <!-- Membri Asociați (Angajați din departament) -->
                        <div class="mb-4">
                            <h6 class="fw-bold mb-3 d-flex align-items-center justify-content-between">
                                <span><i class="bi bi-people me-2" style="color: #4f46e5;"></i>Assigned Employees</span>
                                <span class="badge rounded-pill text-indigo" style="background-color: #eef2ff; color: #4f46e5;">
                                    @department.Employees.Count Members
                                </span>
                            </h6>

                            @if (!department.Employees.Any())
                            {
                                <div class="text-center py-3 border rounded-3 bg-white text-muted small">
                                    No employees currently assigned to this department.
                                </div>
                            }
                            else
                            {
                                <ul class="list-group list-group-flush border rounded-3 overflow-hidden">
                                    @foreach (var emp in department.Employees)
                                    {
                                        var empName = $"{emp.FirstName} {emp.LastName}".Trim();
                                        var initials = !string.IsNullOrWhiteSpace(empName)
                                        ? empName.Substring(0, Math.Min(2, empName.Length)).ToUpper()
                                        : "EM";

                                        <li class="list-group-item d-flex justify-content-between align-items-center py-2.5">
                                            <div class="d-flex align-items-center gap-3">
                                                <div class="rounded-circle d-flex align-items-center justify-content-center fw-bold"
                                                     style="width: 36px; height: 36px; background-color: #eef2ff; color: #4f46e5; font-size: 0.85rem;">
                                                    @initials
                                                </div>
                                                <div>
                                                    <strong class="text-dark d-block">@(string.IsNullOrWhiteSpace(empName) ? "Unknown Employee" : empName)</strong>
                                                    <span class="text-muted small">@emp.Email</span>
                                                </div>
                                            </div>
                                            <span class="badge @(emp.IsActive ? "bg-success-subtle text-success border border-success-subtle" : "bg-danger-subtle text-danger border border-danger-subtle") rounded-pill px-2.5 py-1">
                                                @(emp.IsActive ? "Active" : "Inactive")
                                            </span>
                                        </li>
                                    }
                                </ul>
                            }
                        </div>

                        <!-- Acțiuni Subsol -->
                        <div class="d-flex justify-content-between align-items-center pt-3 border-top">
                            <a href="/departments" class="btn btn-light border px-4">Back to List</a>
                            <a href="@($"/departments/delete?id={department.Id}")" class="btn btn-outline-danger px-3">
                                <i class="bi bi-trash me-1"></i> Delete Department
                            </a>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private Department? department;

    [SupplyParameterFromQuery]
    private Guid Id { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = await DbFactory.CreateDbContextAsync();

        // Include lista angajaților din departament
        department = await context.Departments
            .Include(d => d.Employees)
            .FirstOrDefaultAsync(m => m.Id == Id);

        if (department is null)
        {
            NavigationManager.NavigateTo("/departments");
        }
    }
}