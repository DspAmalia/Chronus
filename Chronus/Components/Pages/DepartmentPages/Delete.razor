@page "/departments/delete"
@using Microsoft.EntityFrameworkCore
@using Chronus.Models.MainModels
@inject IDbContextFactory<Chronus.Data.ChronusDbContext> DbFactory
@inject NavigationManager NavigationManager
@rendermode InteractiveServer

<PageTitle>Chronus - Delete Department</PageTitle>

<div class="container-fluid mt-4">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <!-- Header Navigare -->
            <div class="mb-3">
                <a href="/departments" class="text-decoration-none text-muted small">
                    <i class="bi bi-arrow-left me-1"></i> Back to Departments List
                </a>
            </div>

            <!-- Card Confirmare Ștergere -->
            <div class="card border-danger shadow-sm rounded-4">
                <div class="card-header bg-danger text-white py-3 border-bottom-0">
                    <div class="d-flex align-items-center">
                        <i class="bi bi-exclamation-triangle-fill fs-3 me-3"></i>
                        <div>
                            <h4 class="mb-0 fw-bold">Delete Department</h4>
                            <p class="mb-0 small opacity-75">Are you sure you want to permanently delete this department?</p>
                        </div>
                    </div>
                </div>

                <div class="card-body p-4">
                    @if (department is null)
                    {
                        <div class="d-flex justify-content-center py-4">
                            <div class="spinner-border text-danger" role="status">
                                <span class="visually-hidden">Loading...</span>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-warning border-0 d-flex align-items-center mb-4" role="alert">
                            <i class="bi bi-info-circle-fill me-2 fs-5"></i>
                            <div class="small">
                                Employees currently assigned to this department will become <strong>unassigned</strong>.
                            </div>
                        </div>

                        <div class="bg-light p-3 rounded-3 mb-4 border">
                            <div class="row mb-2">
                                <div class="col-sm-4 text-muted fw-semibold">Department Name:</div>
                                <div class="col-sm-8 fw-bold text-dark">@department.Name</div>
                            </div>
                            <div class="row">
                                <div class="col-sm-4 text-muted fw-semibold">Description:</div>
                                <div class="col-sm-8 text-secondary">@(string.IsNullOrWhiteSpace(department.Description) ? "-" : department.Description)</div>
                            </div>
                        </div>

                        <!-- Actions -->
                        <div class="d-flex justify-content-between align-items-center pt-3 border-top">
                            <a href="/departments" class="btn btn-light border px-4">Cancel</a>
                            <button type="button" @onclick="DeleteDepartment" class="btn btn-danger px-4 d-flex align-items-center gap-2" disabled="@isDeleting">
                                @if (isDeleting)
                                {
                                    <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                                    <span>Deleting...</span>
                                }
                                else
                                {
                                    <i class="bi bi-trash-fill"></i>
                                    <span>Confirm Delete</span>
                                }
                            </button>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private Department? department;
    private bool isDeleting = false;

    [SupplyParameterFromQuery]
    private Guid Id { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = await DbFactory.CreateDbContextAsync();
        department = await context.Departments.FirstOrDefaultAsync(m => m.Id == Id);

        if (department is null)
        {
            NavigationManager.NavigateTo("/departments");
        }
    }

    private async Task DeleteDepartment()
    {
        if (department is null || isDeleting) return;
        isDeleting = true;

        try
        {
            using var context = await DbFactory.CreateDbContextAsync();
            context.Departments.Remove(department);
            await context.SaveChangesAsync();

            NavigationManager.NavigateTo("/departments");
        }
        finally
        {
            isDeleting = false;
        }
    }
}