@page "/"
@page "/clocking"
@using Chronus.Data
@using Chronus.Models.MainModels
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity

@inject IDbContextFactory<ChronusDbContext> DbFactory
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject UserManager<Employee> UserManager
@rendermode InteractiveServer
@implements IAsyncDisposable
@inject NavigationManager Navigation

@attribute [Authorize]

<PageTitle>Attendance & Clocking | Chronus</PageTitle>

<div class="container-fluid mt-4 px-4">
    <!-- Header Principal -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3 mb-4">
        <div>
            <div class="d-flex align-items-center gap-2">
                <div class="rounded-3 text-white p-2 d-flex align-items-center justify-content-center shadow-sm" style="width: 44px; height: 44px; background: linear-gradient(135deg, #4f46e5, #6366f1);">
                    <i class="bi bi-laptop fs-5"></i>
                </div>
                <div>
                    <h3 class="fw-bold text-dark mb-0">Device & Attendance Management</h3>
                    <p class="text-muted small mb-0">Link your hardware machine name to your web account for automated clocking.</p>
                </div>
            </div>
        </div>

        <div class="d-flex align-items-center gap-2">
            @if (currentEmployee != null)
            {
                <span class="badge bg-indigo-subtle text-indigo border border-indigo-subtle px-3 py-2 fw-medium" style="background-color: #eef2ff; color: #4f46e5; border-color: #c7d2fe !important;">
                    <i class="bi bi-person-fill me-1"></i> Logged in as: @currentEmployee.FirstName @currentEmployee.LastName
                </span>
            }
            <button class="btn btn-light border px-3 py-2 d-flex align-items-center gap-2 shadow-xs fw-medium rounded-3" @onclick="LoadDataAsync">
                <i class="bi bi-arrow-clockwise text-indigo" style="color: #4f46e5;"></i>
                <span>Refresh Log</span>
            </button>
        </div>
    </div>

    <!-- FORMULARUL APARE DOAR DACĂ DISPOZITIVUL NU ESTE ÎNREGISTRAT -->
    @if (!isDeviceRegistered)
    {
        <div class="row mb-4">
            <div class="col-12 col-lg-6">
                <div class="card border-0 shadow-sm rounded-4 p-4" style="background-color: #fffbeb; border: 1px solid #fde68a !important;">
                    <h5 class="fw-bold text-warning-emphasis mb-2"><i class="bi bi-exclamation-triangle-fill me-2"></i>Register Current Device</h5>
                    <p class="text-muted small mb-3">Click the button below to link this PC (`@inputMachineName`) to your web account.</p>

                    @if (!string.IsNullOrEmpty(statusMessage))
                    {
                        <div class="alert @statusAlertClass py-2 small mb-3" role="alert">
                            @statusMessage
                        </div>
                    }

                    <button class="btn btn-warning text-dark w-100 py-2 fw-medium rounded-3 shadow-xs" @onclick="RegisterDeviceAsync">
                        <i class="bi bi-link-45deg me-1"></i> Link Current Device to My Account
                    </button>
                </div>
            </div>
        </div>
    }

    <!-- Card Principal cu Tabel -->
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-4">
        <div class="card-header bg-white py-3 border-bottom border-light">
            <div class="d-flex flex-column flex-md-row align-items-start align-items-md-center justify-content-between gap-3">
                <!-- Search bar în stânga -->
                <div class="col-12 col-md-5">
                    <div class="input-group">
                        <span class="input-group-text bg-transparent border-end-0 text-muted ps-3">
                            <i class="bi bi-search"></i>
                        </span>
                        <input type="text"
                               class="form-control border-start-0 bg-transparent py-2 shadow-none"
                               placeholder="Search employee name or email..."
                               @bind="searchTerm"
                               @bind:event="oninput" />
                    </div>
                </div>

                <!-- Textul cu auto-refresh în dreapta -->
                <div class="d-flex align-items-center gap-2 text-muted small ms-md-auto">
                    <span class="spinner-grow spinner-grow-sm text-success" role="status" aria-hidden="true" style="width: 0.5rem; height: 0.5rem;"></span>
                    <span>Auto-refreshing every 5s</span>
                </div>
            </div>
        </div>

        <div class="card-body p-0">
            @if (isLoading)
            {
                <div class="d-flex justify-content-center align-items-center py-5">
                    <div class="spinner-border text-indigo" role="status" style="color: #4f46e5;">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                </div>
            }
            else if (!FilteredEntries.Any())
            {
                <div class="text-center py-5 bg-white">
                    <i class="bi bi-calendar-x display-6 d-block mb-2 text-muted opacity-50"></i>
                    <h6 class="fw-bold text-dark mb-1">No time records found</h6>
                    <p class="text-muted small mb-0">There are no attendance entries matching your current view criteria.</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="bg-light text-uppercase fs-8 text-muted fw-bold">
                            <tr>
                                <th class="ps-4 py-3">Employee</th>
                                <th class="py-3">Date</th>
                                <th class="py-3">Clock In (Local)</th>
                                <th class="py-3">Net Work Time</th>
                                <th class="py-3">Break Time</th>
                                <th class="py-3">Confidence Score</th>
                                <th class="pe-4 py-3 text-end">Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var entry in FilteredEntries)
                            {
                                var hours = entry.NetWorkMinutes / 60;
                                var mins = entry.NetWorkMinutes % 60;
                                var empName = $"{entry.Employee?.FirstName} {entry.Employee?.LastName}".Trim();
                                var initials = !string.IsNullOrWhiteSpace(empName)
                                ? empName.Substring(0, Math.Min(2, empName.Length)).ToUpper()
                                : "EM";
                                var scorePercentage = entry.ConfidenceScore * 100;

                                <tr>
                                    <td class="ps-4 py-3">
                                        <div class="d-flex align-items-center gap-3">
                                            <div class="rounded-circle d-flex align-items-center justify-content-center fw-bold"
                                                 style="width: 38px; height: 38px; background-color: #eef2ff; color: #4f46e5; font-size: 0.85rem;">
                                                @initials
                                            </div>
                                            <div>
                                                <strong class="text-dark d-block">@(string.IsNullOrWhiteSpace(empName) ? "Unknown Employee" : empName)</strong>
                                                <span class="text-muted fs-8">@entry.Employee?.Email</span>
                                            </div>
                                        </div>
                                    </td>
                                    <td class="py-3 text-secondary small fw-medium">
                                        <i class="bi bi-calendar-event me-1 text-muted"></i>
                                        @entry.Date.ToString("dd MMM yyyy")
                                    </td>
                                    <td class="py-3 font-monospace text-secondary small">
                                        <i class="bi bi-box-arrow-in-right me-1 text-muted"></i>
                                        @entry.ClockInUtc.ToLocalTime().ToString("HH:mm:ss")
                                    </td>
                                    <td class="py-3">
                                        <span class="badge bg-light text-dark border font-monospace px-2 py-1 fs-7">
                                            @hours h @mins m
                                        </span>
                                    </td>
                                    <td class="py-3 text-secondary small">
                                        <span class="text-muted">@entry.TotalBreakMinutes mins</span>
                                    </td>
                                    <td class="py-3">
                                        <div class="d-flex align-items-center gap-2" style="max-width: 130px;">
                                            <div class="progress flex-grow-1" style="height: 6px;">
                                                <div class="progress-bar @GetConfidenceColorClass(scorePercentage)"
                                                     role="progressbar"
                                                     style="width: @scorePercentage%"
                                                     aria-valuenow="@scorePercentage"
                                                     aria-valuemin="0"
                                                     aria-valuemax="100">
                                                </div>
                                            </div>
                                            <span class="fw-bold fs-8 text-dark">@scorePercentage.ToString("F0")%</span>
                                        </div>
                                    </td>
                                    <td class="pe-4 py-3 text-end">
                                        @if (entry.ClockOutUtc.HasValue && entry.Status == EntryStatus.InProgress)
                                        {
                                            <span class="badge rounded-pill bg-warning-subtle text-warning border border-warning-subtle px-3 py-2 fw-medium">
                                                <i class="bi bi-pause-fill me-1"></i> On Break
                                            </span>
                                        }
                                        else switch (entry.Status)
                                            {
                                                case EntryStatus.InProgress:
                                                    <span class="badge rounded-pill bg-success-subtle text-success border border-success-subtle px-3 py-2 fw-medium">
                                                        <i class="bi bi-play-fill me-1"></i> Active
                                                    </span>
                                                    break;
                                                case EntryStatus.Approved:
                                                    <span class="badge rounded-pill bg-indigo-subtle text-indigo border border-indigo-subtle px-3 py-2 fw-medium" style="background-color: #eef2ff; color: #4f46e5; border-color: #c7d2fe !important;">
                                                        <i class="bi bi-check-circle-fill me-1"></i> Approved
                                                    </span>
                                                    break;
                                                default:
                                                    <span class="badge rounded-pill bg-secondary-subtle text-secondary border border-secondary-subtle px-3 py-2 fw-medium">
                                                        @entry.Status
                                                    </span>
                                                    break;
                                            }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

<style>
    .fs-8 {
        font-size: 0.75rem;
    }

    .fs-7 {
        font-size: 0.8rem;
    }

    .shadow-xs {
        box-shadow: 0 1px 2px 0 rgba(0, 0, 0, 0.05);
    }
</style>

@code {
    private List<TimeEntry> timeEntries = new();
    private bool isLoading = true;
    private string searchTerm = string.Empty;

    private PeriodicTimer? _timer;
    private CancellationTokenSource _cts = new();
    private Employee? currentEmployee;

    private string inputMachineName = Environment.MachineName;
    private string statusMessage = string.Empty;
    private string statusAlertClass = "alert-info";
    private bool isDeviceRegistered = false;

    protected override async Task OnInitializedAsync()
    {
        await ResolveCurrentEmployeeAsync();

        // 🔑 Dacă utilizatorul nu este logat, îl trimitem imediat la login!
        if (currentEmployee == null)
        {
            Navigation.NavigateTo("/employees/login", forceLoad: true);
            return;
        }

        await CheckDeviceRegistrationAsync();
        await EnsureTodayTimeEntryExistsAsync();

        await LoadDataAsync();

        _timer = new PeriodicTimer(TimeSpan.FromSeconds(3));
        _ = PollDatabaseAsync();
    }

    private async Task CheckDeviceRegistrationAsync()
    {
        if (currentEmployee == null) return;

        using var db = await DbFactory.CreateDbContextAsync();
        isDeviceRegistered = await db.UserDevices
            .AnyAsync(d => d.MachineName == inputMachineName && d.EmployeeId == currentEmployee.Id);
    }

    private async Task EnsureTodayTimeEntryExistsAsync()
    {
        if (currentEmployee == null) return;

        using var db = await DbFactory.CreateDbContextAsync();
        var today = DateOnly.FromDateTime(DateTime.Today);

        bool entryExists = await db.TimeEntries
            .AnyAsync(t => t.EmployeeId == currentEmployee.Id && t.Date == today);

        if (!entryExists)
        {
            var newEntry = new TimeEntry
                {
                    Id = Guid.NewGuid(),
                    EmployeeId = currentEmployee.Id,
                    Date = today,
                    ClockInUtc = DateTime.UtcNow,
                    NetWorkMinutes = 0,
                    TotalBreakMinutes = 0,
                    Status = EntryStatus.InProgress,
                    ConfidenceScore = 1.00m
                };

            db.TimeEntries.Add(newEntry);
            await db.SaveChangesAsync();
        }
    }

    private async Task ResolveCurrentEmployeeAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (user.Identity != null && user.Identity.IsAuthenticated)
        {
            currentEmployee = await UserManager.GetUserAsync(user);

            if (currentEmployee == null)
            {
                var identifier = user.Identity.Name ?? user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
                if (!string.IsNullOrEmpty(identifier))
                {
                    using var db = await DbFactory.CreateDbContextAsync();
                    currentEmployee = await db.Employees
                        .FirstOrDefaultAsync(e => e.Email == identifier || e.UserName == identifier);
                }
            }
        }
    }

    private async Task RegisterDeviceAsync()
    {
        if (currentEmployee == null)
        {
            statusMessage = "Error: You must be logged in to register a device.";
            statusAlertClass = "alert-danger";
            return;
        }

        try
        {
            using var db = await DbFactory.CreateDbContextAsync();

            var existingDevice = await db.UserDevices
                .FirstOrDefaultAsync(d => d.MachineName == inputMachineName);

            if (existingDevice != null)
            {
                existingDevice.EmployeeId = currentEmployee.Id;
                existingDevice.LastSeenUtc = DateTime.UtcNow;
                db.UserDevices.Update(existingDevice);
            }
            else
            {
                var newDevice = new UserDevice
                    {
                        Id = Guid.NewGuid(),
                        EmployeeId = currentEmployee.Id,
                        MachineName = inputMachineName,
                        LastSeenUtc = DateTime.UtcNow
                    };
                db.UserDevices.Add(newDevice);
            }

            await db.SaveChangesAsync();

            // Setăm starea ca înregistrată, ceea ce va ascunde automat cardul galben
            isDeviceRegistered = true;
        }
        catch (Exception ex)
        {
            statusMessage = $"Error linking device: {ex.Message}";
            statusAlertClass = "alert-danger";
        }
    }

    private async Task PollDatabaseAsync()
    {
        try
        {
            while (await _timer!.WaitForNextTickAsync(_cts.Token))
            {
                // 🔑 Verificăm la fiecare 3 secunde (în timpul auto-refresh-ului) dacă a expirat sesiunea
                var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
                if (authState.User.Identity == null || !authState.User.Identity.IsAuthenticated)
                {
                    Navigation.NavigateTo("/employees/login", forceLoad: true);
                    break;
                }

                await LoadDataAsync();
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException) { }
    }

    private async Task LoadDataAsync()
    {
        using var db = await DbFactory.CreateDbContextAsync();

        var query = db.TimeEntries
            .Include(t => t.Employee)
            .AsQueryable();

        if (currentEmployee != null)
        {
            query = query.Where(t => t.EmployeeId == currentEmployee.Id);
        }

        timeEntries = await query
            .OrderByDescending(t => t.Date)
            .ThenByDescending(t => t.ClockInUtc)
            .ToListAsync();

        isLoading = false;
    }

    private IEnumerable<TimeEntry> FilteredEntries
    {
        get
        {
            var entries = timeEntries;

            if (!string.IsNullOrWhiteSpace(searchTerm))
            {
                entries = entries.Where(t =>
                    (t.Employee != null && (t.Employee.FirstName.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ||
                                            t.Employee.LastName.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ||
                                            t.Employee.Email.Contains(searchTerm, StringComparison.OrdinalIgnoreCase)))).ToList();
            }

            return entries;
        }
    }

    private string GetConfidenceColorClass(decimal score)
    {
        if (score >= 80) return "bg-success";
        if (score >= 50) return "bg-warning";
        return "bg-danger";
    }

    public async ValueTask DisposeAsync()
    {
        _cts.Cancel();
        _cts.Dispose();
        _timer?.Dispose();
    }
}