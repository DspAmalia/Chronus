@page "/employees"
@using Microsoft.EntityFrameworkCore
@using Chronus.Models.MainModels
@using Chronus.Data
@using Microsoft.AspNetCore.Authorization

@inject IDbContextFactory<Chronus.Data.ChronusDbContext> DbFactory
@rendermode InteractiveServer

@attribute [Authorize(Roles = "Manager,Admin")]

<PageTitle>Employees Management | Chronus</PageTitle>

<div class="container-fluid mt-4 px-4 mb-5">
    <!-- Header Section -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3 mb-4">
        <div>
            <div class="d-flex align-items-center gap-2">
                <div class="rounded-3 text-white p-2 d-flex align-items-center justify-content-center shadow-sm" style="width: 44px; height: 44px; background: linear-gradient(135deg, #4f46e5, #6366f1);">
                    <i class="bi bi-people-fill fs-5"></i>
                </div>
                <div>
                    <h3 class="fw-bold text-dark mb-0">Employees</h3>
                    <p class="text-muted small mb-0">Manage workforce directory, assigned roles, departments, and work targets.</p>
                </div>
            </div>
        </div>

        <div class="d-flex align-items-center gap-2">
            <!-- View Switcher -->
            <div class="btn-group bg-light p-1 rounded-3 border" role="group">
                <button type="button" class="btn btn-sm @(isGridView ? "btn-white shadow-xs fw-semibold" : "text-muted")" @onclick="() => isGridView = true">
                    <i class="bi bi-grid-fill me-1"></i> Cards
                </button>
                <button type="button" class="btn btn-sm @(!isGridView ? "btn-white shadow-xs fw-semibold" : "text-muted")" @onclick="() => isGridView = false">
                    <i class="bi bi-list-task me-1"></i> List
                </button>
            </div>

            <a href="employees/create" class="btn text-white px-3 py-2 d-flex align-items-center gap-2 shadow-sm fw-medium rounded-3" style="background-color: #4f46e5; border: none;">
                <i class="bi bi-person-plus-fill"></i>
                <span>Add Employee</span>
            </a>
        </div>
    </div>

    <!-- Toolbar & Search -->
    <div class="card border-0 shadow-sm rounded-4 mb-4">
        <div class="card-body p-3">
            <div class="row g-3 align-items-center justify-content-between">
                <div class="col-12 col-md-5">
                    <div class="input-group">
                        <span class="input-group-text bg-transparent border-end-0 text-muted ps-3">
                            <i class="bi bi-search"></i>
                        </span>
                        <input type="text"
                               class="form-control border-start-0 bg-transparent py-2 shadow-none"
                               placeholder="Search employee by name or email..."
                               @bind="searchTerm"
                               @bind:event="oninput" />
                    </div>
                </div>
                <div class="col-auto text-muted small d-flex align-items-center gap-3">
                    <span>Total Employees: <strong class="text-dark">@employeesList.Count</strong></span>
                    <span class="border-end py-2"></span>
                    <span>Filtered: <strong style="color: #4f46e5;">@FilteredEmployees.Count()</strong></span>
                </div>
            </div>
        </div>
    </div>

    <!-- RENDERIZARE CONDIȚIONALĂ -->
    @if (isGridView)
    {
        @if (!FilteredEmployees.Any())
        {
            <div class="text-center py-5 bg-white rounded-4 shadow-sm border">
                <i class="bi bi-person-x text-muted display-4"></i>
                <h5 class="mt-3 text-dark fw-semibold">No employees found</h5>
                <p class="text-muted small">Try adjusting your search filter or add a new employee.</p>
            </div>
        }
        else
        {
            <div class="row g-4">
                @foreach (var emp in FilteredEmployees)
                {
                    <div class="col-12 col-md-6 col-xl-4">
                        <div class="card border-0 shadow-sm rounded-4 h-100 card-hover transition-all position-relative overflow-hidden" style="border: 1px solid #eef2f6 !important;">
                            <div class="card-body p-4 d-flex flex-column justify-content-between">
                                <div>
                                    <!-- Header Profile Info -->
                                    <div class="d-flex justify-content-between align-items-start mb-3">
                                        <div class="d-flex align-items-center gap-3">
                                            <div class="rounded-circle d-flex align-items-center justify-content-center fw-bold shadow-xs"
                                                 style="width: 48px; height: 48px; background: linear-gradient(135deg, #4f46e5, #6366f1); color: #ffffff; font-size: 1.1rem;">
                                                @($"{emp.FirstName?.FirstOrDefault()}{emp.LastName?.FirstOrDefault()}".ToUpper())
                                            </div>
                                            <div>
                                                <h5 class="fw-bold text-dark mb-0">@emp.FirstName @emp.LastName</h5>
                                                <span class="text-muted small font-monospace">@emp.Email</span>
                                            </div>
                                        </div>
                                        <span class="badge @(emp.IsActive ? "bg-success-subtle text-success border border-success-subtle" : "bg-danger-subtle text-danger border border-danger-subtle") rounded-pill px-2.5 py-1">
                                            @(emp.IsActive ? "Active" : "Inactive")
                                        </span>
                                    </div>

                                    <!-- Badges & Roles -->
                                    <div class="d-flex flex-wrap gap-2 mb-3">
                                        @if (emp.Department != null)
                                        {
                                            <span class="badge rounded-pill px-2.5 py-1.5 border" style="background-color: #eef2ff; color: #4f46e5; border-color: #c7d2fe !important;">
                                                <i class="bi bi-building me-1"></i> @emp.Department.Name
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-light text-muted border font-monospace">No Dept</span>
                                        }

                                        @if (emp.Role != null)
                                        {
                                            <span class="badge rounded-pill px-2.5 py-1.5 border" style="background-color: #f1f5f9; color: #334155; border-color: #cbd5e1 !important;">
                                                <i class="bi bi-shield-check me-1 text-primary"></i> @emp.Role.Name
                                            </span>
                                        }
                                    </div>
                                </div>

                                <div>
                                    <hr class="my-3 opacity-10" />

                                    <!-- Card Footer -->
                                    <div class="d-flex align-items-center justify-content-between">
                                        <div class="d-flex align-items-center gap-1 text-muted small">
                                            <i class="bi bi-clock" style="color: #6366f1;"></i>
                                            <span class="fw-semibold text-dark me-1">@emp.DailyTargetMinutes min</span>
                                            <span>(@((emp.DailyTargetMinutes / 60.0).ToString("F1"))h/day)</span>
                                        </div>

                                        <div class="d-flex align-items-center gap-2">
                                            <a href="@($"employees/details?id={emp.Id}")" class="btn btn-icon btn-light rounded-circle shadow-xs" title="View Details">
                                                <i class="bi bi-eye text-secondary"></i>
                                            </a>
                                            <a href="@($"employees/edit?id={emp.Id}")" class="btn btn-icon btn-light rounded-circle shadow-xs" title="Edit Profile">
                                                <i class="bi bi-pencil text-warning"></i>
                                            </a>
                                            <a href="@($"employees/delete?id={emp.Id}")" class="btn btn-icon btn-light rounded-circle shadow-xs" title="Delete Employee">
                                                <i class="bi bi-trash3 text-danger"></i>
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    }
    else
    {
        <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-light text-uppercase fs-8 text-muted fw-bold">
                        <tr>
                            <th class="ps-4 py-3">Employee</th>
                            <th class="py-3">Department & Role</th>
                            <th class="py-3">Target / Day</th>
                            <th class="py-3">Status</th>
                            <th class="pe-4 py-3 text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!FilteredEmployees.Any())
                        {
                            <tr>
                                <td colspan="5" class="text-center py-4 text-muted">No employees found.</td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var emp in FilteredEmployees)
                            {
                                <tr>
                                    <td class="ps-4 py-3">
                                        <div class="d-flex align-items-center gap-3">
                                            <div class="rounded-circle d-flex align-items-center justify-content-center fw-bold shadow-xs"
                                                 style="width: 38px; height: 38px; background: linear-gradient(135deg, #4f46e5, #6366f1); color: #ffffff; font-size: 0.9rem;">
                                                @($"{emp.FirstName?.FirstOrDefault()}{emp.LastName?.FirstOrDefault()}".ToUpper())
                                            </div>
                                            <div>
                                                <span class="fw-bold text-dark d-block">@emp.FirstName @emp.LastName</span>
                                                <span class="text-muted small font-monospace">@emp.Email</span>
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        <div class="d-flex flex-column gap-1">
                                            <span class="small fw-semibold text-dark">
                                                <i class="bi bi-building me-1 text-indigo"></i> @(emp.Department?.Name ?? "N/A")
                                            </span>
                                            <span class="text-muted small">
                                                <i class="bi bi-shield-check me-1 text-primary"></i> @(emp.Role?.Name ?? "No Role")
                                            </span>
                                        </div>
                                    </td>
                                    <td>
                                        <span class="fw-medium text-dark">@emp.DailyTargetMinutes min</span>
                                        <span class="text-muted small d-block">@((emp.DailyTargetMinutes / 60.0).ToString("F1")) hrs/day</span>
                                    </td>
                                    <td>
                                        <span class="badge @(emp.IsActive ? "bg-success-subtle text-success border border-success-subtle" : "bg-danger-subtle text-danger border border-danger-subtle") rounded-pill px-2.5 py-1">
                                            @(emp.IsActive ? "Active" : "Inactive")
                                        </span>
                                    </td>
                                    <td class="pe-4 text-end">
                                        <div class="d-inline-flex gap-2">
                                            <a href="@($"employees/details?id={emp.Id}")" class="btn btn-sm btn-light border fw-medium px-3">Details</a>
                                            <a href="@($"employees/edit?id={emp.Id}")" class="btn btn-sm btn-light border text-warning fw-medium px-3">Edit</a>
                                            <a href="@($"employees/delete?id={emp.Id}")" class="btn btn-sm btn-light border text-danger fw-medium px-3">Delete</a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

<style>
    .card-hover {
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

        .card-hover:hover {
            transform: translateY(-3px);
            box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.08) !important;
        }

    .btn-icon {
        width: 34px;
        height: 34px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 0;
    }

    .btn-white {
        background-color: #ffffff;
        color: #1e293b;
    }

    .fs-8 {
        font-size: 0.75rem;
    }

    .shadow-xs {
        box-shadow: 0 1px 2px 0 rgba(0, 0, 0, 0.05);
    }

    .text-indigo {
        color: #4f46e5 !important;
    }
</style>

@code {
    private List<Employee> employeesList = new();
    private string searchTerm = string.Empty;
    private bool isGridView = true;

    protected override async Task OnInitializedAsync()
    {
        await LoadEmployeesAsync();
    }

    private async Task LoadEmployeesAsync()
    {
        using var db = await DbFactory.CreateDbContextAsync();
        employeesList = await db.Employees
            .Include(e => e.Department)
            .Include(e => e.Role)
            .ToListAsync();
    }

    private IEnumerable<Employee> FilteredEmployees
    {
        get
        {
            if (string.IsNullOrWhiteSpace(searchTerm))
                return employeesList;

            return employeesList.Where(e =>
                (e.FirstName != null && e.FirstName.Contains(searchTerm, StringComparison.OrdinalIgnoreCase)) ||
                (e.LastName != null && e.LastName.Contains(searchTerm, StringComparison.OrdinalIgnoreCase)) ||
                (e.Email != null && e.Email.Contains(searchTerm, StringComparison.OrdinalIgnoreCase)));
        }
    }
}