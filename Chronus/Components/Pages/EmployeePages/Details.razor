@page "/employees/details"
@using Microsoft.EntityFrameworkCore
@using Chronus.Models.MainModels
@inject IDbContextFactory<Chronus.Data.ChronusDbContext> DbFactory
@inject NavigationManager NavigationManager
@rendermode InteractiveServer

<PageTitle>Chronus - Employee Details</PageTitle>

<div class="container-fluid mt-4 mb-5">
    <div class="row justify-content-center">
        <div class="col-md-9 col-lg-7">
            <!-- Header Navigare -->
            <div class="mb-3">
                <a href="/employees" class="text-decoration-none text-muted small">
                    <i class="bi bi-arrow-left me-1"></i> Back to Employees List
                </a>
            </div>

            <!-- Card Principal Profile -->
            <div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-4">
                <div class="card-header bg-white py-3 border-bottom-0">
                    <div class="d-flex align-items-center justify-content-between">
                        <div class="d-flex align-items-center gap-3">
                            <div class="rounded-circle p-3 d-flex align-items-center justify-content-center fw-bold shadow-sm"
                                 style="background: linear-gradient(135deg, #4f46e5, #6366f1); color: #ffffff; width: 52px; height: 52px; font-size: 1.2rem;">
                                @(employee != null ? $"{employee.FirstName?.FirstOrDefault()}{employee.LastName?.FirstOrDefault()}".ToUpper() : "EM")
                            </div>
                            <div>
                                <h4 class="mb-0 fw-bold text-dark">@(employee != null ? $"{employee.FirstName} {employee.LastName}" : "Employee Profile")</h4>
                                <p class="text-muted small mb-0">Detailed workforce profile and organizational parameters.</p>
                            </div>
                        </div>
                        @if (employee is not null)
                        {
                            <a href="@($"/employees/edit?id={employee.Id}")" class="btn btn-outline-primary btn-sm d-flex align-items-center gap-1">
                                <i class="bi bi-pencil"></i> Edit Profile
                            </a>
                        }
                    </div>
                </div>

                <div class="card-body p-4">
                    @if (employee is null)
                    {
                        <div class="d-flex justify-content-center py-5">
                            <div class="spinner-border text-indigo" role="status" style="color: #4f46e5;">
                                <span class="visually-hidden">Loading profile...</span>
                            </div>
                        </div>
                    }
                    else
                    {
                        <!-- KPI / Target Overview -->
                        <div class="row g-3 mb-4">
                            <div class="col-12 col-sm-6">
                                <div class="bg-light p-3 rounded-3 border">
                                    <span class="text-uppercase text-muted fw-bold fs-8 d-block mb-1">Status & Account State</span>
                                    <div class="d-flex align-items-center gap-2">
                                        <span class="badge @(employee.IsActive ? "bg-success-subtle text-success border border-success-subtle" : "bg-danger-subtle text-danger border border-danger-subtle") rounded-pill px-3 py-1.5 fw-medium">
                                            <i class="bi @(employee.IsActive ? "bi-check-circle-fill" : "bi-x-circle-fill") me-1"></i>
                                            @(employee.IsActive ? "Active Member" : "Inactive / Suspended")
                                        </span>
                                    </div>
                                </div>
                            </div>

                            <div class="col-12 col-sm-6">
                                <div class="bg-light p-3 rounded-3 border">
                                    <span class="text-uppercase text-muted fw-bold fs-8 d-block mb-1">Daily Work Target</span>
                                    <div class="d-flex align-items-baseline gap-2">
                                        <strong class="fs-5 text-dark mb-0">@employee.DailyTargetMinutes min</strong>
                                        <span class="text-muted small">(@((employee.DailyTargetMinutes / 60.0).ToString("F1")) hrs/day)</span>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Date Generale Profil -->
                        <div class="bg-light p-3 rounded-3 mb-4 border">
                            <div class="row mb-3 align-items-center">
                                <div class="col-sm-4 text-muted fw-semibold"><i class="bi bi-envelope me-2 text-indigo"></i>Email Address:</div>
                                <div class="col-sm-8 text-dark font-monospace fw-medium">@employee.Email</div>
                            </div>
                            <div class="row mb-3 align-items-center">
                                <div class="col-sm-4 text-muted fw-semibold"><i class="bi bi-building me-2 text-indigo"></i>Department:</div>
                                <div class="col-sm-8 text-dark">
                                    @if (employee.Department != null)
                                    {
                                        <span class="badge rounded-pill px-3 py-2 border" style="background-color: #eef2ff; color: #4f46e5; border-color: #c7d2fe !important;">
                                            <i class="bi bi-building me-1"></i> @employee.Department.Name
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted italic">Unassigned</span>
                                    }
                                </div>
                            </div>
                            <div class="row mb-3 align-items-center">
                                <div class="col-sm-4 text-muted fw-semibold"><i class="bi bi-shield-lock me-2 text-indigo"></i>Access Role:</div>
                                <div class="col-sm-8 text-dark">
                                    @if (employee.Role != null)
                                    {
                                        <span class="badge rounded-pill px-3 py-2 border" style="background-color: #f1f5f9; color: #334155; border-color: #cbd5e1 !important;">
                                            <i class="bi bi-shield-check me-1 text-primary"></i> @employee.Role.Name
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted italic">No Role Assigned</span>
                                    }
                                </div>
                            </div>
                            <div class="row align-items-center">
                                <div class="col-sm-4 text-muted fw-semibold"><i class="bi bi-calendar3 me-2 text-indigo"></i>Created At:</div>
                                <div class="col-sm-8 text-secondary font-monospace small">@employee.CreatedAtUtc.ToString("dd MMM yyyy, HH:mm:ss") UTC</div>
                            </div>
                        </div>

                        <!-- Acțiuni Subsol -->
                        <div class="d-flex justify-content-between align-items-center pt-3 border-top">
                            <a href="/employees" class="btn btn-light border px-4">Back to List</a>
                            <a href="@($"/employees/delete?id={employee.Id}")" class="btn btn-outline-danger px-3">
                                <i class="bi bi-trash me-1"></i> Delete Employee
                            </a>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .text-indigo {
        color: #4f46e5 !important;
    }

    .fs-8 {
        font-size: 0.75rem;
    }
</style>

@code {
    private Employee? employee;

    [SupplyParameterFromQuery]
    private Guid Id { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = await DbFactory.CreateDbContextAsync();

        // Încarcă angajatul împreună cu departamentul și rolul asociat
        employee = await context.Employees
            .Include(e => e.Department)
            .Include(e => e.Role)
            .FirstOrDefaultAsync(m => m.Id == Id);

        if (employee is null)
        {
            NavigationManager.NavigateTo("/employees");
        }
    }
}