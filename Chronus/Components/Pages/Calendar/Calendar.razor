@code {
    private enum CalendarViewMode { Day, WorkWeek, FullWeek }
    private enum RecurrenceType { None, Daily, Weekdays, Weekly, Monthly }
    private enum RsvpStatus { Pending, Accepted, Declined }

    private sealed record InviteeRsvpItem(string DisplayName, RsvpStatus Status);

    private sealed class MeetingActionItemRecord
    {
        public string Title { get; set; } = string.Empty;
        public string AssigneeName { get; set; } = string.Empty;
        public DateTime DueDate { get; set; }
    }

    private static readonly Regex RsvpTagRegex = new(@"\[RSVP:(Pending|Accepted|Declined)\]\s*$", RegexOptions.Compiled);
    private static readonly Regex MeetingNotesSectionRegex = new(@"--- MEETING NOTES ---\r?\n(.*?)\r?\n--- END MEETING NOTES ---", RegexOptions.Singleline | RegexOptions.Compiled);
    private static readonly Regex ActionItemsSectionRegex = new(@"--- ACTION ITEMS ---\r?\n(.*?)\r?\n--- END ACTION ITEMS ---", RegexOptions.Singleline | RegexOptions.Compiled);

    private CalendarViewMode currentViewMode = CalendarViewMode.FullWeek;
    private RecurrenceType recurrenceType = RecurrenceType.None;
    private DateTime recurrenceEndDate = DateTime.Today.AddMonths(1);

    private List<CalendarEvent> eventsList = new();
    private List<Employee> allEmployees = new();
    private List<Guid> selectedEmployeeIds = new();
    private List<DateTime> displayedDays = new();
    private DateTime currentDate = DateTime.Today;

    private List<string> availableCategories = new();
    private HashSet<string> selectedCategories = new(StringComparer.OrdinalIgnoreCase);
    private bool onlyEventsWithDeclinedInvitees = false;
    private HashSet<string> eventsWithDeclinedInvitees = new(StringComparer.Ordinal);

    private bool showAddModal = false;
    private bool showDetailsModal = false;
    private bool showDeleteSeriesModal = false;
    private bool isSaving = false;
    private bool isDeleting = false;
    private bool isUpdatingRsvp = false;
    private bool isSavingRecap = false;
    private bool isCreatingActionItem = false;
    private string formErrorMessage = string.Empty;
    private string recapStatusMessage = string.Empty;
    private string selectedCategoryOption = "Meeting";
    private string customCategory = string.Empty;
    private CalendarEvent? viewingEvent = null;
    private List<InviteeRsvpItem> viewingInvitees = new();
    private CalendarEvent? pendingDeleteEvent = null;
    private CalendarEvent newEvent = new();
    private string currentEmployeeId = string.Empty;
    private Guid selectedEventId = Guid.Empty;

    private string meetingNotesDraft = string.Empty;
    private string actionItemTitle = string.Empty;
    private string actionItemAssigneeId = string.Empty;
    private DateTime actionItemDueDate = DateTime.Today.AddDays(1).AddHours(9);
    private List<MeetingActionItemRecord> meetingActionItems = new();

    private System.Timers.Timer? alertTimer;
    private HashSet<Guid> alerted10Min = new();
    private HashSet<Guid> alerted5Min = new();

    private string toastMessage = string.Empty;
    private string toastType = "success";

    private string EffectiveCategory =>
        string.Equals(selectedCategoryOption, "Other", StringComparison.OrdinalIgnoreCase)
            ? (string.IsNullOrWhiteSpace(customCategory) ? "Task" : customCategory.Trim())
            : selectedCategoryOption;

    private bool IsMeetingCategory(string? category)
    {
        return !string.IsNullOrWhiteSpace(category) &&
               category.Trim().Equals("Meeting", StringComparison.OrdinalIgnoreCase);
    }

    private static RsvpStatus ExtractRsvpStatus(string? description)
    {
        if (string.IsNullOrEmpty(description)) return RsvpStatus.Pending;
        var match = RsvpTagRegex.Match(description);
        if (match.Success && Enum.TryParse<RsvpStatus>(match.Groups[1].Value, out var parsed))
        {
            return parsed;
        }
        return RsvpStatus.Pending;
    }

    private static string ExtractMeetingNotes(string? description)
    {
        if (string.IsNullOrEmpty(description)) return string.Empty;
        var match = MeetingNotesSectionRegex.Match(description);
        return match.Success ? match.Groups[1].Value.Trim() : string.Empty;
    }

    private static List<MeetingActionItemRecord> ExtractActionItems(string? description)
    {
        if (string.IsNullOrEmpty(description)) return new List<MeetingActionItemRecord>();
        var match = ActionItemsSectionRegex.Match(description);
        if (!match.Success) return new List<MeetingActionItemRecord>();

        try
        {
            var items = JsonSerializer.Deserialize<List<MeetingActionItemRecord>>(match.Groups[1].Value.Trim());
            return items ?? new List<MeetingActionItemRecord>();
        }
        catch
        {
            return new List<MeetingActionItemRecord>();
        }
    }

    private static string StripRsvpTag(string? description)
    {
        if (string.IsNullOrEmpty(description)) return string.Empty;
        var withoutRsvp = RsvpTagRegex.Replace(description, string.Empty);
        var withoutNotes = MeetingNotesSectionRegex.Replace(withoutRsvp, string.Empty);
        var withoutActions = ActionItemsSectionRegex.Replace(withoutNotes, string.Empty);
        return withoutActions.Trim();
    }

    private static string ComposeDescription(
        string? baseDescription,
        string? notes,
        List<MeetingActionItemRecord>? actionItems,
        RsvpStatus? rsvpStatus)
    {
        var cleanBase = StripRsvpTag(baseDescription);
        var parts = new List<string>();

        if (!string.IsNullOrWhiteSpace(cleanBase))
        {
            parts.Add(cleanBase.Trim());
        }

        if (!string.IsNullOrWhiteSpace(notes))
        {
            parts.Add($"--- MEETING NOTES ---\n{notes.Trim()}\n--- END MEETING NOTES ---");
        }

        if (actionItems != null && actionItems.Any())
        {
            var json = JsonSerializer.Serialize(actionItems);
            parts.Add($"--- ACTION ITEMS ---\n{json}\n--- END ACTION ITEMS ---");
        }

        if (rsvpStatus.HasValue)
        {
            parts.Add($"[RSVP:{rsvpStatus.Value}]");
        }

        return string.Join("\n", parts);
    }

    private static string ApplyRsvpTag(string? description, RsvpStatus status)
    {
        return ComposeDescription(
            description,
            ExtractMeetingNotes(description),
            ExtractActionItems(description),
            status);
    }

    private static string GetEventSeriesOrSlotKey(CalendarEvent ev)
    {
        return $"{ev.CreatedById}|{(ev.Title ?? string.Empty).Trim()}|{(ev.Category ?? string.Empty).Trim()}|{ev.StartTime:yyyy-MM-dd HH:mm}|{ev.EndTime:yyyy-MM-dd HH:mm}";
    }

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        var employee = await UserManager.GetUserAsync(user);

        if (employee != null)
        {
            currentEmployeeId = employee.Id.ToString();

            using var db = await DbFactory.CreateDbContextAsync();
            allEmployees = await db.Users.ToListAsync();

            UpdateDisplayedDays();
            await LoadEventsAsync();
        }

        alertTimer = new System.Timers.Timer(20000);
        alertTimer.Elapsed += CheckUpcomingEventsAlerts;
        alertTimer.AutoReset = true;
        alertTimer.Enabled = true;
    }

    private void CheckUpcomingEventsAlerts(object? sender, ElapsedEventArgs e)
    {
        var now = DateTime.Now;

        foreach (var ev in eventsList)
        {
            if (!IsMeetingCategory(ev.Category))
            {
                continue;
            }

            var timeUntilStart = (ev.StartTime - now).TotalMinutes;

            if (timeUntilStart >= 9 && timeUntilStart <= 11 && !alerted10Min.Contains(ev.Id))
            {
                alerted10Min.Add(ev.Id);
                TriggerAlert($"Meeting \"{ev.Title}\" starts in 10 minutes.");
                break;
            }
            else if (timeUntilStart >= 4 && timeUntilStart <= 6 && !alerted5Min.Contains(ev.Id))
            {
                alerted5Min.Add(ev.Id);
                TriggerAlert($"Meeting \"{ev.Title}\" starts in 5 minutes!");
                break;
            }
        }

        InvokeAsync(StateHasChanged);
    }

    private void TriggerAlert(string message)
    {
        InvokeAsync(async () =>
        {
            toastMessage = message;
            toastType = "warning";
            StateHasChanged();
            await JS.InvokeVoidAsync("eval", "document.getElementById('alertSound').play()");
        });
    }

    public void Dispose()
    {
        if (alertTimer != null)
        {
            alertTimer.Elapsed -= CheckUpcomingEventsAlerts;
            alertTimer.Dispose();
        }
    }

    private void SetViewMode(CalendarViewMode mode)
    {
        currentViewMode = mode;
        UpdateDisplayedDays();
    }

    private void UpdateDisplayedDays()
    {
        displayedDays.Clear();
        if (currentViewMode == CalendarViewMode.Day)
        {
            displayedDays.Add(currentDate.Date);
        }
        else if (currentViewMode == CalendarViewMode.WorkWeek)
        {
            int diff = (7 + (currentDate.DayOfWeek - DayOfWeek.Monday)) % 7;
            var startOfWeek = currentDate.AddDays(-diff).Date;
            for (int i = 0; i < 5; i++)
            {
                displayedDays.Add(startOfWeek.AddDays(i));
            }
        }
        else
        {
            int diff = (7 + (currentDate.DayOfWeek - DayOfWeek.Monday)) % 7;
            var startOfWeek = currentDate.AddDays(-diff).Date;
            for (int i = 0; i < 7; i++)
            {
                displayedDays.Add(startOfWeek.AddDays(i));
            }
        }
    }

    private void PreviousPeriod()
    {
        currentDate = currentViewMode switch
        {
            CalendarViewMode.Day => currentDate.AddDays(-1),
            CalendarViewMode.WorkWeek => currentDate.AddDays(-7),
            _ => currentDate.AddDays(-7)
        };
        UpdateDisplayedDays();
        _ = LoadEventsAsync();
    }

    private void NextPeriod()
    {
        currentDate = currentViewMode switch
        {
            CalendarViewMode.Day => currentDate.AddDays(1),
            CalendarViewMode.WorkWeek => currentDate.AddDays(7),
            _ => currentDate.AddDays(7)
        };
        UpdateDisplayedDays();
        _ = LoadEventsAsync();
    }

    private void CurrentPeriod()
    {
        currentDate = DateTime.Today;
        UpdateDisplayedDays();
        _ = LoadEventsAsync();
    }

    private async Task LoadEventsAsync()
    {
        if (string.IsNullOrEmpty(currentEmployeeId) || !displayedDays.Any()) return;

        using var db = await DbFactory.CreateDbContextAsync();

        var startDate = displayedDays.First().AddDays(-30);
        var endDate = displayedDays.Last().AddDays(30);

        var rawEvents = await db.CalendarEvent
            .Where(e => e.EndTime >= startDate && e.StartTime <= endDate &&
                        (e.EmployeeId.ToString() == currentEmployeeId ||
                         (e.CreatedById.ToString() == currentEmployeeId &&
                          e.Category != null &&
                          e.Category.ToLower() != "task")))
            .OrderBy(e => e.StartTime)
            .ToListAsync();

        var declinedKeys = new HashSet<string>(StringComparer.Ordinal);
        foreach (var item in rawEvents)
        {
            if (item.CreatedById != Guid.Empty &&
                item.EmployeeId != item.CreatedById &&
                ExtractRsvpStatus(item.Description) == RsvpStatus.Declined)
            {
                declinedKeys.Add(GetEventSeriesOrSlotKey(item));
            }
        }
        eventsWithDeclinedInvitees = declinedKeys;

        eventsList = rawEvents
            .GroupBy(e => new { e.Title, e.StartTime, e.EndTime, e.Category })
            .Select(g => g.FirstOrDefault(x => x.EmployeeId.ToString() == currentEmployeeId) ?? g.First())
            .ToList();

        var previousCategories = new HashSet<string>(selectedCategories, StringComparer.OrdinalIgnoreCase);

        availableCategories = eventsList
            .Select(e => e.Category)
            .Where(c => !string.IsNullOrEmpty(c))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToList()!;

        if (!previousCategories.Any() && availableCategories.Any())
        {
            selectedCategories = new HashSet<string>(availableCategories, StringComparer.OrdinalIgnoreCase);
        }
        else
        {
            var knownInView = previousCategories.ToHashSet(StringComparer.OrdinalIgnoreCase);
            foreach (var cat in availableCategories)
            {
                if (!knownInView.Contains(cat))
                {
                    selectedCategories.Add(cat);
                }
            }
        }
    }
    private void ToggleCategoryFilter(string category)
    {
        if (!selectedCategories.Remove(category))
        {
            selectedCategories.Add(category);
        }
    }

    private Task ToggleOnlyDeclinedFilterAsync()
    {
        onlyEventsWithDeclinedInvitees = !onlyEventsWithDeclinedInvitees;
        return Task.CompletedTask;
    }

    private void ToggleEmployeeSelection(Guid empId)
    {
        if (!selectedEmployeeIds.Remove(empId))
        {
            selectedEmployeeIds.Add(empId);
        }
    }

    private void OpenAddModal()
    {
        var now = DateTime.Now;
        var roundedStart = new DateTime(now.Year, now.Month, now.Day, Math.Clamp(now.Hour, 8, 19), 0, 0);

        formErrorMessage = string.Empty;
        selectedCategoryOption = "Meeting";
        customCategory = string.Empty;
        recurrenceType = RecurrenceType.None;
        recurrenceEndDate = roundedStart.Date.AddMonths(1);
        newEvent = new CalendarEvent
            {
                StartTime = roundedStart,
                EndTime = roundedStart.AddHours(1),
                Priority = AgendaPriority.Normal,
                Category = "Meeting"
            };
