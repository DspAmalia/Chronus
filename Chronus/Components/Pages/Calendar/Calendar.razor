    }

    private void CloseAddModal()
    {
        formErrorMessage = string.Empty;
        customCategory = string.Empty;
        recurrenceType = RecurrenceType.None;
        showAddModal = false;
        selectedEmployeeIds.Clear();
    }

    private List<(DateTime Start, DateTime End)> BuildOccurrenceIntervals(
        DateTime startTime,
        TimeSpan duration,
        RecurrenceType type,
        DateTime untilDate)
    {
        var intervals = new List<(DateTime Start, DateTime End)>();

        if (type == RecurrenceType.None)
        {
            intervals.Add((startTime, startTime + duration));
            return intervals;
        }

        var clampedUntil = untilDate.Date < startTime.Date
            ? startTime.Date
            : (untilDate.Date > startTime.Date.AddYears(2) ? startTime.Date.AddYears(2) : untilDate.Date);

        const int maxOccurrences = 180;

        if (type == RecurrenceType.Monthly)
        {
            int monthOffset = 0;
            while (intervals.Count < maxOccurrences)
            {
                var targetMonth = new DateTime(startTime.Year, startTime.Month, 1).AddMonths(monthOffset);
                if (targetMonth.Date > clampedUntil)
                {
                    break;
                }

                int daysInMonth = DateTime.DaysInMonth(targetMonth.Year, targetMonth.Month);
                int day = Math.Min(startTime.Day, daysInMonth);
                var occStart = new DateTime(targetMonth.Year, targetMonth.Month, day, startTime.Hour, startTime.Minute, startTime.Second);

                if (occStart.Date >= startTime.Date && occStart.Date <= clampedUntil)
                {
                    intervals.Add((occStart, occStart + duration));
                }

                monthOffset++;
            }

            return intervals;
        }

        for (var d = startTime.Date; d <= clampedUntil && intervals.Count < maxOccurrences; d = d.AddDays(1))
        {
            bool includeDay = type switch
            {
                RecurrenceType.Daily => true,
                RecurrenceType.Weekdays => d.DayOfWeek != DayOfWeek.Saturday && d.DayOfWeek != DayOfWeek.Sunday,
                RecurrenceType.Weekly => d.DayOfWeek == startTime.DayOfWeek,
                _ => false
            };

            if (includeDay)
            {
                var occStart = new DateTime(d.Year, d.Month, d.Day, startTime.Hour, startTime.Minute, startTime.Second);
                intervals.Add((occStart, occStart + duration));
            }
        }

        return intervals;
    }

    private async Task<CalendarEvent?> FindConflictingMeetingAsync(
        ChronusDbContext db,
        IEnumerable<Guid> employeeIds,
        DateTime startTime,
        DateTime endTime,
        Guid? excludeEventId = null)
    {
        var targetIds = employeeIds.Distinct().ToList();

        var candidates = await db.CalendarEvent
            .Where(e => targetIds.Contains(e.EmployeeId) &&
                        e.Category != null &&
                        e.Category.ToLower() == "meeting" &&
                        e.StartTime < endTime &&
                        e.EndTime > startTime)
            .OrderBy(e => e.StartTime)
            .ToListAsync();

        return candidates.FirstOrDefault(e => !excludeEventId.HasValue || e.Id != excludeEventId.Value);
    }

    private async Task SaveEvent()
    {
        if (isSaving || string.IsNullOrWhiteSpace(newEvent.Title)) return;

        formErrorMessage = string.Empty;

        var normalizedCategory = EffectiveCategory;
        var startTime = newEvent.StartTime;
        var endTime = newEvent.EndTime <= newEvent.StartTime ? newEvent.StartTime.AddMinutes(30) : newEvent.EndTime;
        var duration = endTime - startTime;

        var occurrences = BuildOccurrenceIntervals(startTime, duration, recurrenceType, recurrenceEndDate);
        if (!occurrences.Any())
        {
            formErrorMessage = "Nu s-a putut genera nicio dată validă pentru intervalul de recurență selectat.";
            return;
        }

        isSaving = true;
        try
        {
            using var db = await DbFactory.CreateDbContextAsync();
            var organizerId = Guid.Parse(currentEmployeeId);
            var involvedEmployeeIds = selectedEmployeeIds
                .Distinct()
                .Append(organizerId)
                .ToList();

            if (IsMeetingCategory(normalizedCategory))
            {
                foreach (var occ in occurrences)
                {
                    var conflictingMeeting = await FindConflictingMeetingAsync(db, involvedEmployeeIds, occ.Start, occ.End);
                    if (conflictingMeeting != null)
                    {
                        formErrorMessage = $"Conflict pe {occ.Start:dd MMM yyyy}: există deja meeting-ul \"{conflictingMeeting.Title}\" ({conflictingMeeting.StartTime:HH:mm} - {conflictingMeeting.EndTime:HH:mm}). În acest interval poți adăuga doar Task-uri sau alte activități non-meeting.";
                        return;
                    }
                }
            }

            var cleanDesc = StripRsvpTag(newEvent.Description);

            foreach (var occ in occurrences)
            {
                var primaryEvent = new CalendarEvent
                    {
                        Id = Guid.NewGuid(),
                        Title = newEvent.Title.Trim(),
                        Category = normalizedCategory,
                        Priority = newEvent.Priority,
                        Description = string.IsNullOrEmpty(cleanDesc) ? null : cleanDesc,
                        StartTime = occ.Start,
                        EndTime = occ.End,
                        IsOnline = IsMeetingCategory(normalizedCategory) ? newEvent.IsOnline : null,
                        EmployeeId = organizerId,
                        CreatedById = organizerId
                    };

                db.CalendarEvent.Add(primaryEvent);

                foreach (var invitedId in selectedEmployeeIds.Distinct().Where(id => id != organizerId))
                {
                    db.CalendarEvent.Add(new CalendarEvent
                        {
                            Id = Guid.NewGuid(),
                            Title = primaryEvent.Title,
                            Category = primaryEvent.Category,
                            Priority = primaryEvent.Priority,
                            Description = ComposeDescription(cleanDesc, null, null, RsvpStatus.Pending),
                            StartTime = primaryEvent.StartTime,
                            EndTime = primaryEvent.EndTime,
                            IsOnline = primaryEvent.IsOnline,
                            EmployeeId = invitedId,
                            CreatedById = organizerId
                        });
                }
            }

            await db.SaveChangesAsync();

            var firstOccDate = occurrences.First().Start.Date;
            if (!displayedDays.Any(d => d.Date == firstOccDate))
            {
                currentDate = firstOccDate;
                UpdateDisplayedDays();
            }

            selectedCategories.Add(normalizedCategory);
            await LoadEventsAsync();
            CloseAddModal();
        }
        catch (Exception ex)
        {
            formErrorMessage = $"Eroare la salvare: {ex.Message}";
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task OpenDetailsModal(CalendarEvent ev)
    {
        viewingEvent = ev;
        viewingInvitees.Clear();
        recapStatusMessage = string.Empty;
        meetingNotesDraft = ExtractMeetingNotes(ev.Description);
        meetingActionItems = ExtractActionItems(ev.Description);
        actionItemTitle = string.Empty;
        actionItemAssigneeId = currentEmployeeId;

        var defaultDue = ev.EndTime.Date >= DateTime.Today
            ? new DateTime(ev.EndTime.Date.AddDays(1).Year, ev.EndTime.Date.AddDays(1).Month, ev.EndTime.Date.AddDays(1).Day, Math.Clamp(ev.EndTime.Hour, 9, 17), 0, 0)
            : DateTime.Today.AddDays(1).AddHours(9);
        actionItemDueDate = defaultDue;

        showDetailsModal = true;

        var isOwner = ev.CreatedById == Guid.Empty || ev.CreatedById.ToString() == currentEmployeeId;
        if (isOwner && ev.CreatedById != Guid.Empty)
        {
            await LoadInviteesForEventAsync(ev);
        }
    }

    private async Task SaveMeetingNotesAsync()
    {
        if (viewingEvent == null || isSavingRecap) return;
        isSavingRecap = true;
        recapStatusMessage = string.Empty;

        try
        {
            using var db = await DbFactory.CreateDbContextAsync();
            var dbEvent = await db.CalendarEvent.FirstOrDefaultAsync(e => e.Id == viewingEvent.Id);
            if (dbEvent == null) return;

            var isOwner = dbEvent.CreatedById == Guid.Empty || dbEvent.CreatedById.ToString() == currentEmployeeId;
            RsvpStatus? rsvp = isOwner ? null : ExtractRsvpStatus(dbEvent.Description);

            dbEvent.Description = ComposeDescription(
                dbEvent.Description,
                meetingNotesDraft,
                meetingActionItems,
                rsvp);

            await db.SaveChangesAsync();
            viewingEvent = dbEvent;
            recapStatusMessage = "Notes saved";
            await LoadEventsAsync();
        }
        finally
        {
            isSavingRecap = false;
        }
    }

    private async Task AddActionItemAsTaskAsync()
    {
        if (viewingEvent == null || isCreatingActionItem || string.IsNullOrWhiteSpace(actionItemTitle)) return;
        isCreatingActionItem = true;
        recapStatusMessage = string.Empty;

        try
        {
            using var db = await DbFactory.CreateDbContextAsync();

            var creatorGuid = Guid.TryParse(currentEmployeeId, out var parsedCurrent)
                ? parsedCurrent
                : (viewingEvent.CreatedById != Guid.Empty ? viewingEvent.CreatedById : viewingEvent.EmployeeId);

            var assigneeGuid = Guid.TryParse(actionItemAssigneeId, out var parsedAssignee)
                ? parsedAssignee
                : creatorGuid;

            var assigneeEmp = allEmployees.FirstOrDefault(e => e.Id == assigneeGuid);
            var assigneeLabel = assigneeEmp?.Email ?? assigneeEmp?.UserName ?? "Assigned";

            var dueStart = actionItemDueDate;
            var dueEnd = dueStart.AddMinutes(30);

            var taskEvent = new CalendarEvent
                {
                    Id = Guid.NewGuid(),
                    Title = actionItemTitle.Trim(),
                    Category = "Task",
                    Priority = viewingEvent.Priority,
                    Description = $"Action item from meeting \"{viewingEvent.Title}\" ({viewingEvent.StartTime:dd MMM yyyy}).",
                    StartTime = dueStart,
                    EndTime = dueEnd,
                    EmployeeId = assigneeGuid,
                    CreatedById = creatorGuid
                };

            db.CalendarEvent.Add(taskEvent);

            var updatedItems = new List<MeetingActionItemRecord>(meetingActionItems)
            {
                new MeetingActionItemRecord
                {
                    Title = actionItemTitle.Trim(),
                    AssigneeName = assigneeLabel,
                    DueDate = dueStart
                }
            };

            var dbMeeting = await db.CalendarEvent.FirstOrDefaultAsync(e => e.Id == viewingEvent.Id);
            if (dbMeeting != null)
            {
                var isOwner = dbMeeting.CreatedById == Guid.Empty || dbMeeting.CreatedById.ToString() == currentEmployeeId;
                RsvpStatus? rsvp = isOwner ? null : ExtractRsvpStatus(dbMeeting.Description);

                dbMeeting.Description = ComposeDescription(
                    dbMeeting.Description,
                    meetingNotesDraft,
                    updatedItems,
                    rsvp);

                viewingEvent = dbMeeting;
            }

            await db.SaveChangesAsync();

            meetingActionItems = updatedItems;
            actionItemTitle = string.Empty;
            recapStatusMessage = "Action item & Task created";
            selectedCategories.Add("Task");

            if (!displayedDays.Any(d => d.Date == dueStart.Date))
            {
                currentDate = dueStart.Date;
                UpdateDisplayedDays();
            }

            await LoadEventsAsync();
        }
        finally
        {
            isCreatingActionItem = false;
        }
    }

    private async Task LoadInviteesForEventAsync(CalendarEvent organizerEvent)
    {
        using var db = await DbFactory.CreateDbContextAsync();
        var inviteeRows = await db.CalendarEvent
            .Where(e => e.CreatedById == organizerEvent.CreatedById &&
                        e.EmployeeId != organizerEvent.CreatedById &&
                        e.Title == organizerEvent.Title &&
                        e.StartTime == organizerEvent.StartTime &&
                        e.EndTime == organizerEvent.EndTime)
            .ToListAsync();

        var empLookup = allEmployees.ToDictionary(e => e.Id, e => e.Email ?? e.UserName ?? e.Id.ToString());

        viewingInvitees = inviteeRows
            .Select(r => new InviteeRsvpItem(
                empLookup.TryGetValue(r.EmployeeId, out var name) ? name : r.EmployeeId.ToString(),
                ExtractRsvpStatus(r.Description)))
            .OrderBy(i => i.DisplayName)
            .ToList();
    }

    private async Task RespondToInvitationAsync(CalendarEvent ev, RsvpStatus status)
    {
        if (isUpdatingRsvp || string.IsNullOrEmpty(currentEmployeeId)) return;
        isUpdatingRsvp = true;

        try
        {
            using var db = await DbFactory.CreateDbContextAsync();
            var empGuid = Guid.Parse(currentEmployeeId);

            var target = await db.CalendarEvent.FirstOrDefaultAsync(e => e.Id == ev.Id);
            if (target != null)
            {
                target.Description = ApplyRsvpTag(target.Description, status);
                viewingEvent = target;
            }

            if (ev.CreatedById != Guid.Empty && ev.CreatedById != empGuid)
            {
                var organizerCopies = await db.CalendarEvent
                    .Where(e => e.EmployeeId == ev.CreatedById &&
                                e.CreatedById == ev.CreatedById &&
                                e.Title == ev.Title &&
                                e.StartTime == ev.StartTime &&
                                e.EndTime == ev.EndTime)
                    .ToListAsync();

                foreach (var orgCopy in organizerCopies)
                {
                    orgCopy.Description = ApplyRsvpTag(orgCopy.Description, status);
                }
            }

            await db.SaveChangesAsync();
            await LoadEventsAsync();
        }
        finally
        {
            isUpdatingRsvp = false;
        }
    }

    private void CloseDetailsModal()
    {
        showDetailsModal = false;
        viewingEvent = null;
        viewingInvitees.Clear();
        meetingActionItems.Clear();
        meetingNotesDraft = string.Empty;
        actionItemTitle = string.Empty;
        recapStatusMessage = string.Empty;
    }

