    {
        selectedEventId = Guid.Empty;
    }

    private async Task OnSlotClick(DateTime targetSlotTime)
    {
        if (selectedEventId == Guid.Empty) return;

        using var db = await DbFactory.CreateDbContextAsync();
        var ev = await db.CalendarEvent.FirstOrDefaultAsync(e => e.Id == selectedEventId);
        if (ev != null)
        {
            var duration = ev.EndTime - ev.StartTime;
            var newStart = targetSlotTime;
            var newEnd = targetSlotTime + duration;

            if (IsMeetingCategory(ev.Category))
            {
                var conflictingMeeting = await FindConflictingMeetingAsync(
                    db,
                    new[] { ev.EmployeeId },
                    newStart,
                    newEnd,
                    excludeEventId: ev.Id);

                if (conflictingMeeting != null)
                {
                    toastMessage = $"Nu poți muta meeting-ul peste \"{conflictingMeeting.Title}\" ({conflictingMeeting.StartTime:HH:mm} - {conflictingMeeting.EndTime:HH:mm}).";
                    toastType = "warning";
                    selectedEventId = Guid.Empty;
                    StateHasChanged();
                    return;
                }
            }

            ev.StartTime = newStart;
            ev.EndTime = newEnd;
            await db.SaveChangesAsync();
        }

        selectedEventId = Guid.Empty;
        await LoadEventsAsync();
    }

    private async Task RequestDeleteEvent(CalendarEvent ev)
    {
        if (isDeleting) return;

        using var db = await DbFactory.CreateDbContextAsync();
        var seriesCount = await CountSeriesOccurrencesAsync(db, ev);

        if (seriesCount > 1)
        {
            pendingDeleteEvent = ev;
            showDeleteSeriesModal = true;
            return;
        }

        await ExecuteDeleteAsync(ev.Id, deleteEntireSeries: false);
    }

    private void CancelDeleteSeriesModal()
    {
        if (isDeleting) return;
        showDeleteSeriesModal = false;
        pendingDeleteEvent = null;
    }

    private async Task ConfirmDeleteOccurrenceAsync(Guid eventId, bool deleteEntireSeries)
    {
        await ExecuteDeleteAsync(eventId, deleteEntireSeries);
        showDeleteSeriesModal = false;
        pendingDeleteEvent = null;
    }

    private async Task<int> CountSeriesOccurrencesAsync(ChronusDbContext db, CalendarEvent ev)
    {
        var duration = ev.EndTime - ev.StartTime;
        var startTod = ev.StartTime.TimeOfDay;
        var normTitle = (ev.Title ?? string.Empty).Trim();
        var normCat = (ev.Category ?? string.Empty).Trim();
        var normDesc = StripRsvpTag(ev.Description);

        var matches = await db.CalendarEvent
            .Where(e => e.EmployeeId == ev.EmployeeId &&
                        e.CreatedById == ev.CreatedById &&
                        e.Title == normTitle &&
                        (e.Category ?? string.Empty) == normCat)
            .ToListAsync();

        return matches.Count(e =>
            e.StartTime.TimeOfDay == startTod &&
            (e.EndTime - e.StartTime) == duration &&
            StripRsvpTag(e.Description) == normDesc);
    }

    private async Task ExecuteDeleteAsync(Guid eventId, bool deleteEntireSeries)
    {
        if (isDeleting) return;
        isDeleting = true;

        try
        {
            using var db = await DbFactory.CreateDbContextAsync();

            var anchor = await db.CalendarEvent.FirstOrDefaultAsync(e => e.Id == eventId);
            if (anchor == null) return;

            List<CalendarEvent> toDelete;

            if (deleteEntireSeries)
            {
                var duration = anchor.EndTime - anchor.StartTime;
                var startTod = anchor.StartTime.TimeOfDay;
                var normTitle = (anchor.Title ?? string.Empty).Trim();
                var normCat = (anchor.Category ?? string.Empty).Trim();
                var normDesc = StripRsvpTag(anchor.Description);

                var creatorCandidates = await db.CalendarEvent
                    .Where(e => e.CreatedById == anchor.CreatedById &&
                                e.Title == normTitle &&
                                (e.Category ?? string.Empty) == normCat)
                    .ToListAsync();

                toDelete = creatorCandidates
                    .Where(e =>
                        e.StartTime.TimeOfDay == startTod &&
                        (e.EndTime - e.StartTime) == duration &&
                        StripRsvpTag(e.Description) == normDesc)
                    .ToList();
            }
            else
            {
                var normTitle = (anchor.Title ?? string.Empty).Trim();
                var normCat = (anchor.Category ?? string.Empty).Trim();
                var normDesc = StripRsvpTag(anchor.Description);

                var sameSlotCandidates = await db.CalendarEvent
                    .Where(e => e.CreatedById == anchor.CreatedById &&
                                e.StartTime == anchor.StartTime &&
                                e.EndTime == anchor.EndTime &&
                                e.Title == normTitle &&
                                (e.Category ?? string.Empty) == normCat)
                    .ToListAsync();

                toDelete = sameSlotCandidates
                    .Where(e => StripRsvpTag(e.Description) == normDesc)
                    .ToList();

                if (!toDelete.Any())
                {
                    toDelete = new List<CalendarEvent> { anchor };
                }
            }

            var targetIds = toDelete.Select(e => e.Id).ToList();

            var attendances = await db.MeetingAttendances
                .Where(a => targetIds.Contains(a.Id))
                .ToListAsync();

            if (attendances.Any())
            {
                db.MeetingAttendances.RemoveRange(attendances);
            }

            db.CalendarEvent.RemoveRange(toDelete);
            await db.SaveChangesAsync();

            if (targetIds.Contains(selectedEventId))
            {
                selectedEventId = Guid.Empty;
            }

            await LoadEventsAsync();
        }
        catch (Exception ex)
        {
            toastMessage = $"Nu s-a putut șterge evenimentul: {ex.Message}";
            toastType = "warning";
            StateHasChanged();
        }
        finally
        {
            isDeleting = false;
        }
    }

