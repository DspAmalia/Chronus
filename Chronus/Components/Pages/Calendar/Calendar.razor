@page "/calendar"
@using Chronus.Data
@using Chronus.Models.MainModels
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using System.Globalization
@using System.Text.Json
@using System.Text.RegularExpressions
@using System.Timers
@inject IDbContextFactory<ChronusDbContext> DbFactory
@inject UserManager<Employee> UserManager
@inject AuthenticationStateProvider AuthStateProvider
@inject Microsoft.JSInterop.IJSRuntime JS
@rendermode InteractiveServer

@implements IDisposable

@attribute [Authorize]

<PageTitle>Teams Calendar | Chronus</PageTitle>

<div class="container-fluid mt-3 px-4 mb-5">
    <!-- Main Header & Controls -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3 mb-3">
        <div>
            <div class="d-flex align-items-center gap-3">
                <div class="rounded-3 text-white p-2 d-flex align-items-center justify-content-center shadow-sm" style="width: 44px; height: 44px; background: linear-gradient(135deg, #4f46e5, #6366f1);">
                    <i class="bi bi-calendar-week fs-5"></i>
                </div>
                <div>
                    <h3 class="fw-bold text-dark mb-0">Schedule Calendar</h3>
                    <p class="text-muted small mb-0">Interactive enterprise timeline with live time tracking & view modes.</p>
                </div>
            </div>
        </div>

        <div class="d-flex flex-wrap align-items-center gap-2">
            <!-- View Mode Switcher (Day / Work Week / Full Week) -->
            <div class="btn-group shadow-sm">
                <button class="btn @(currentViewMode == CalendarViewMode.Day ? "btn-primary" : "btn-outline-secondary bg-white text-dark")" @onclick="() => SetViewMode(CalendarViewMode.Day)">Day</button>
                <button class="btn @(currentViewMode == CalendarViewMode.WorkWeek ? "btn-primary" : "btn-outline-secondary bg-white text-dark")" @onclick="() => SetViewMode(CalendarViewMode.WorkWeek)">Work Week</button>
                <button class="btn @(currentViewMode == CalendarViewMode.FullWeek ? "btn-primary" : "btn-outline-secondary bg-white text-dark")" @onclick="() => SetViewMode(CalendarViewMode.FullWeek)">Full Week</button>
            </div>

            @if (selectedEventId != Guid.Empty)
            {
                <div class="alert alert-warning py-1 px-3 mb-0 d-flex align-items-center gap-2 shadow-sm fs-8">
                    <span><i class="bi bi-info-circle-fill me-1"></i> <strong>Event selected!</strong> Click any time slot to move it.</span>
                    <button class="btn btn-sm btn-outline-dark py-0 px-2 ms-2" @onclick="CancelSelection">Cancel</button>
                </div>
            }

            <div class="btn-group shadow-sm">
                <button class="btn btn-outline-secondary bg-white text-dark" @onclick="PreviousPeriod">
                    <i class="bi bi-chevron-left"></i>
                </button>
                <button class="btn btn-outline-secondary bg-white text-dark px-3 fw-bold" @onclick="CurrentPeriod">
                    Today
                </button>
                <button class="btn btn-outline-secondary bg-white text-dark" @onclick="NextPeriod">
                    <i class="bi bi-chevron-right"></i>
                </button>
            </div>
            <button class="btn btn-primary rounded-pill px-4 shadow-sm" @onclick="OpenAddModal">
                <i class="bi bi-plus-lg me-2"></i> New Event
            </button>
        </div>
    </div>

    <!-- CATEGORY FILTER BAR -->
    <div class="card border-0 shadow-sm rounded-4 p-3 mb-3 bg-white">
        <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
            <div class="d-flex flex-wrap align-items-center gap-3">
                <span class="small fw-bold text-muted text-uppercase"><i class="bi bi-funnel-fill me-1 text-primary"></i> Filter by Category:</span>
                @if (availableCategories.Any())
                {
                    @foreach (var cat in availableCategories)
                    {
                        var isChecked = selectedCategories.Contains(cat);
                        <div class="form-check form-switch mb-0">
                            <input class="form-check-input" type="checkbox" role="switch" id="cat-@cat"
                                   checked="@isChecked"
                                   @onchange="() => ToggleCategoryFilter(cat)" />
                            <label class="form-check-label small fw-semibold text-dark" for="cat-@cat">@cat</label>
                        </div>
                    }
                }
                else
                {
                    <span class="text-muted small fst-italic">No categories available for current view.</span>
                }
            </div>

            <div class="form-check form-switch mb-0">
                <input class="form-check-input" type="checkbox" role="switch" id="onlyDeclinedFilter"
                       checked="@onlyEventsWithDeclinedInvitees"
                       @onchange="ToggleOnlyDeclinedFilterAsync" />
                <label class="form-check-label small fw-semibold text-danger" for="onlyDeclinedFilter">
                    <i class="bi bi-person-x-fill me-1"></i>Only Declined Invitees
                </label>
            </div>
        </div>
    </div>

    <!-- Create Event & Invite Modal -->
    @if (showAddModal)
    {
        <div class="card border-0 shadow-sm rounded-4 p-4 mb-4 bg-light border-start border-primary border-4">
            <h5 class="fw-bold mb-3 text-dark"><i class="bi bi-plus-circle me-2 text-primary"></i>Create Schedule Event & Invite Colleagues</h5>

            @if (!string.IsNullOrEmpty(formErrorMessage))
            {
                <div class="alert alert-danger d-flex align-items-center gap-2 py-2 px-3 mb-3 fs-8" role="alert">
                    <i class="bi bi-exclamation-triangle-fill fs-6"></i>
                    <span>@formErrorMessage</span>
                </div>
            }

            <EditForm Model="newEvent" OnValidSubmit="SaveEvent">
                <DataAnnotationsValidator />
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label small fw-bold">Title</label>
                        <InputText class="form-control" @bind-Value="newEvent.Title" placeholder="e.g. Daily Standup" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label small fw-bold">Category</label>
                        <InputSelect class="form-select" @bind-Value="selectedCategoryOption">
                            <option value="Meeting">Meeting</option>
                            <option value="Task">Task</option>
                            <option value="Other">Other...</option>
                        </InputSelect>

                        @if (string.Equals(selectedCategoryOption, "Other", StringComparison.OrdinalIgnoreCase))
                        {
                            <input type="text"
                                   class="form-control form-control-sm mt-2"
                                   placeholder="Custom category..."
                                   @bind="customCategory" />
                        }
                    </div>
                    <div class="col-md-3">
                        <label class="form-label small fw-bold">Priority</label>
                        <InputSelect class="form-select" @bind-Value="newEvent.Priority">
                            <option value="@AgendaPriority.High">Important</option>
                            <option value="@AgendaPriority.Normal">Normal</option>
                            <option value="@AgendaPriority.Low">Not so important</option>
                        </InputSelect>
                    </div>

                    @if (IsMeetingCategory(EffectiveCategory))
                    {
                        <div class="col-md-12">
                            <div class="form-check form-switch bg-white p-3 border rounded-3 d-flex align-items-center gap-3 shadow-sm">
                                <input class="form-check-input ms-0 me-2" type="checkbox" role="switch" id="isOnlineSwitch"
                                       checked="@(newEvent.IsOnline == true)"
                                       @onchange="(e => newEvent.IsOnline = (bool?)e.Value)" />
                                <label class="form-check-label fw-bold text-dark mb-0" for="isOnlineSwitch">
                                    <i class="bi bi-laptop text-primary me-1"></i>
                                    Online Meeting (Automatically mark attendance as Present)
                                </label>
                            </div>
                        </div>
                    }

                    <div class="col-md-4">
                        <label class="form-label small fw-bold">Start Time</label>
                        <InputDate Type="InputDateType.DateTimeLocal" class="form-control" @bind-Value="newEvent.StartTime" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label small fw-bold">End Time</label>
                        <InputDate Type="InputDateType.DateTimeLocal" class="form-control" @bind-Value="newEvent.EndTime" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label small fw-bold">Invite Colleagues</label>
                        <div class="border rounded bg-white p-2" style="max-height: 120px; overflow-y: auto;">
                            @foreach (var emp in allEmployees.Where(e => e.Id.ToString() != currentEmployeeId))
                            {
                                <div class="form-check fs-8">
                                    <input class="form-check-input" type="checkbox" id="emp-@emp.Id"
                                           checked="@selectedEmployeeIds.Contains(emp.Id)"
                                           @onchange="() => ToggleEmployeeSelection(emp.Id)" />
                                    <label class="form-check-label" for="emp-@emp.Id">
                                        @(emp.Email ?? emp.UserName)
                                    </label>
                                </div>
                            }
                        </div>
                    </div>

                    <!-- Secțiune Evenimente Recurente -->
                    <div class="col-md-6">
                        <label class="form-label small fw-bold">
                            <i class="bi bi-arrow-repeat text-primary me-1"></i>Repeat
                        </label>
                        <InputSelect class="form-select" @bind-Value="recurrenceType">
                            <option value="@RecurrenceType.None">Does not repeat</option>
                            <option value="@RecurrenceType.Daily">Daily (every day)</option>
                            <option value="@RecurrenceType.Weekdays">Weekdays (Monday – Friday)</option>
                            <option value="@RecurrenceType.Weekly">Weekly (same day each week)</option>
                            <option value="@RecurrenceType.Monthly">Monthly (same day each month)</option>
                        </InputSelect>
                    </div>

                    @if (recurrenceType != RecurrenceType.None)
                    {
                        <div class="col-md-6">
                            <label class="form-label small fw-bold">Repeat Until</label>
                            <InputDate Type="InputDateType.Date" class="form-control" @bind-Value="recurrenceEndDate" />
                            <div class="form-text fs-9">
                                Generates occurrences from @newEvent.StartTime.ToString("dd MMM yyyy", CultureInfo.InvariantCulture) through @recurrenceEndDate.ToString("dd MMM yyyy", CultureInfo.InvariantCulture) (max 180 occurrences).
                            </div>
                        </div>
                    }

                    <div class="col-md-12">
                        <label class="form-label small fw-bold">Description</label>
                        <InputTextArea class="form-control" @bind-Value="newEvent.Description" rows="2" placeholder="Optional details..." />
                    </div>
                    <div class="col-12 d-flex justify-content-end gap-2 mt-3">
                        <button type="button" class="btn btn-outline-secondary px-3" @onclick="CloseAddModal" disabled="@isSaving">Cancel</button>
                        <button type="submit" class="btn btn-success px-4" disabled="@isSaving">
                            @(isSaving ? "Saving..." : (recurrenceType != RecurrenceType.None ? "Save Series & Invite" : "Save & Invite"))
                        </button>
                    </div>
                </div>
            </EditForm>
        </div>
    }

    <!-- RECURRING DELETE CONFIRMATION MODAL -->
    @if (showDeleteSeriesModal && pendingDeleteEvent != null)
    {
        <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content border-0 shadow-lg rounded-4">
                    <div class="modal-header border-bottom-0 pb-0">
                        <h5 class="fw-bold text-dark mb-0">
                            <i class="bi bi-arrow-repeat text-danger me-2"></i>Delete Recurring Event
                        </h5>
                        <button type="button" class="btn-close" @onclick="CancelDeleteSeriesModal" disabled="@isDeleting"></button>
                    </div>
                    <div class="modal-body p-4">
                        <p class="text-dark mb-2">
                            <strong>@pendingDeleteEvent.Title</strong> (@pendingDeleteEvent.StartTime.ToString("dd MMM yyyy, HH:mm", CultureInfo.InvariantCulture)) appears to be part of a recurring series.
                        </p>
                        <p class="text-muted small mb-4">
                            Do you want to delete only this occurrence or every occurrence in the series?
                        </p>
                        <div class="d-flex flex-column gap-2">
                            <button type="button"
                                    class="btn btn-outline-danger text-start d-flex justify-content-between align-items-center px-3 py-2"
                                    @onclick="() => ConfirmDeleteOccurrenceAsync(pendingDeleteEvent.Id, deleteEntireSeries: false)"
                                    disabled="@isDeleting">
                                <span>
                                    <i class="bi bi-calendar-event me-2"></i>
                                    <strong>Only this occurrence</strong>
                                </span>
                                <span class="badge bg-light text-danger border">This day</span>
                            </button>
                            <button type="button"
                                    class="btn btn-danger text-start d-flex justify-content-between align-items-center px-3 py-2"
                                    @onclick="() => ConfirmDeleteOccurrenceAsync(pendingDeleteEvent.Id, deleteEntireSeries: true)"
                                    disabled="@isDeleting">
                                <span>
                                    <i class="bi bi-arrow-repeat me-2"></i>
                                    <strong>All events in series</strong>
                                </span>
                                <span class="badge bg-white text-danger">Entire series</span>
                            </button>
                            <button type="button"
                                    class="btn btn-link text-secondary btn-sm mt-1 text-decoration-none"
                                    @onclick="CancelDeleteSeriesModal"
                                    disabled="@isDeleting">
                                Cancel
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- EVENT DETAILS POPUP -->
    @if (showDetailsModal && viewingEvent != null)
    {
        var isOwner = viewingEvent.CreatedById == Guid.Empty || viewingEvent.CreatedById.ToString() == currentEmployeeId;
        var currentRsvp = ExtractRsvpStatus(viewingEvent.Description);
        var cleanDescription = StripRsvpTag(viewingEvent.Description);

        <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
            <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
                <div class="modal-content border-0 shadow-lg rounded-4">
                    <div class="modal-header border-bottom-0 pb-0">
                        <h5 class="fw-bold text-dark mb-0">
                            <i class="bi bi-calendar-event text-primary me-2"></i>Event Details
                        </h5>
                        <button type="button" class="btn-close" @onclick="CloseDetailsModal"></button>
                    </div>
                    <div class="modal-body p-4">
                        <div class="mb-3 d-flex flex-wrap align-items-center gap-2">
                            <span class="badge @GetBadgeClass(viewingEvent.Priority)">@viewingEvent.Category</span>
                            @if (IsMeetingCategory(viewingEvent.Category))
                            {
                                @if (viewingEvent.IsOnline == true)
                                {
                                    <span class="badge bg-info text-dark"><i class="bi bi-laptop me-1"></i>Online Meeting</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary"><i class="bi bi-geo-alt me-1"></i>Offline Meeting</span>
                                }
                            }
                            @if (!isOwner)
                            {
                                <span class="badge @GetRsvpBadgeClass(currentRsvp)">
                                    RSVP: @currentRsvp
                                </span>
                            }
                        </div>
                        <h4 class="fw-bold text-dark mb-3">@viewingEvent.Title</h4>

                        <div class="bg-light p-3 rounded-3 mb-3">
                            <div class="d-flex align-items-center gap-2 text-secondary small mb-2">
                                <i class="bi bi-clock fs-5 text-primary"></i>
                                <div>
                                    <strong>Start:</strong> @viewingEvent.StartTime.ToString("dddd, dd MMM yyyy, HH:mm", CultureInfo.InvariantCulture)<br />
                                    <strong>End:</strong> @viewingEvent.EndTime.ToString("dddd, dd MMM yyyy, HH:mm", CultureInfo.InvariantCulture)
                                </div>
                            </div>
                        </div>

                        @if (!isOwner && viewingEvent.CreatedById != Guid.Empty)
                        {
                            <div class="bg-light border rounded-3 p-3 mb-3">
                                <label class="form-label small fw-bold text-muted text-uppercase d-block mb-2">
                                    <i class="bi bi-reply-fill me-1 text-primary"></i>Your Invitation Response
                                </label>
                                <div class="d-flex flex-wrap gap-2">
                                    <button type="button"
                                            class="btn btn-sm @(currentRsvp == RsvpStatus.Accepted ? "btn-success" : "btn-outline-success")"
                                            disabled="@isUpdatingRsvp"
                                            @onclick="() => RespondToInvitationAsync(viewingEvent, RsvpStatus.Accepted)">
                                        <i class="bi bi-check-lg me-1"></i>Accept
                                    </button>
                                    <button type="button"
                                            class="btn btn-sm @(currentRsvp == RsvpStatus.Declined ? "btn-danger" : "btn-outline-danger")"
                                            disabled="@isUpdatingRsvp"
                                            @onclick="() => RespondToInvitationAsync(viewingEvent, RsvpStatus.Declined)">
                                        <i class="bi bi-x-lg me-1"></i>Decline
                                    </button>
                                </div>
                            </div>
                        }

                        @if (isOwner && viewingInvitees.Any())
                        {
                            <div class="bg-light border rounded-3 p-3 mb-3">
                                <label class="form-label small fw-bold text-muted text-uppercase d-block mb-2">
                                    <i class="bi bi-people-fill me-1 text-primary"></i>Invitees & Status (@viewingInvitees.Count)
                                </label>
                                <div class="d-flex flex-column gap-2" style="max-height: 150px; overflow-y: auto;">
                                    @foreach (var inv in viewingInvitees)
                                    {
                                        <div class="d-flex justify-content-between align-items-center bg-white border rounded-2 px-3 py-2 small">
                                            <span class="text-dark fw-semibold text-truncate me-2">@inv.DisplayName</span>
                                            <span class="badge @GetRsvpBadgeClass(inv.Status) flex-shrink-0">@inv.Status</span>
                                        </div>
                                    }
                                </div>
                            </div>
                        }

                        @if (IsMeetingCategory(viewingEvent.Category))
                        {
                            @if (viewingEvent.IsOnline == true)
                            {
                                <div class="alert alert-success d-flex align-items-center gap-2 py-2 px-3 mb-3 fs-8">
                                    <i class="bi bi-check-circle-fill fs-5"></i>
                                    <span>Online meeting attendance automatically registered as <strong>Present</strong>.</span>
                                </div>
                            }
                            else
                            {
                                <div class="text-center bg-light p-3 rounded-3 mb-3 border">
                                    <label class="form-label small fw-bold text-muted text-uppercase d-block mb-2">
                                        <i class="bi bi-qr-code me-1"></i> Quick Offline Check-In QR Code
                                    </label>
                                    @{
                                        var checkInUrl = $"/checkin?sessionId={viewingEvent.Id}";
                                        var fullUrl = $"https://localhost:5001{checkInUrl}";
                                        var encodedUrl = Uri.EscapeDataString(fullUrl);
                                        var qrImageSrc = $"https://api.qrserver.com/v1/create-qr-code/?size=150x150&data={encodedUrl}";
                                    }
                                    <img src="@qrImageSrc" alt="Meeting QR Code" class="img-thumbnail shadow-sm rounded-3 bg-white p-2" style="width: 120px; height: 120px;" />

                                    <div class="mt-2">
                                        <a href="@checkInUrl" target="_blank" class="btn btn-outline-success btn-sm rounded-pill px-3 shadow-sm fs-9 fw-bold text-decoration-none">
                                            <i class="bi bi-box-arrow-up-right me-1"></i> Test Link Check-In (PC)
                                        </a>
                                    </div>
                                </div>
                            }
                        }

                        <div class="mb-3">
                            <label class="form-label small fw-bold text-muted text-uppercase">Description</label>
                            <p class="text-dark bg-white border p-3 rounded-3 mb-0" style="min-height: 60px; white-space: pre-line;">
                                @(!string.IsNullOrEmpty(cleanDescription) ? cleanDescription : "No description provided.")
                            </p>
                        </div>

                        <!-- MEETING NOTES & ACTION ITEMS -->
                        @if (IsMeetingCategory(viewingEvent.Category))
                        {
                            <div class="bg-light border rounded-3 p-3 mb-3">
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <label class="form-label small fw-bold text-primary text-uppercase mb-0">
                                        <i class="bi bi-journal-text me-1"></i>Meeting Notes & Recap
                                    </label>
                                    @if (!string.IsNullOrEmpty(recapStatusMessage))
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle">@recapStatusMessage</span>
                                    }
                                </div>

                                <textarea class="form-control form-control-sm bg-white mb-2"
                                          rows="3"
                                          placeholder="Write key decisions, summary, or follow-up notes after the meeting..."
                                          @bind="meetingNotesDraft"></textarea>

                                <div class="d-flex justify-content-end mb-3">
                                    <button type="button"
                                            class="btn btn-primary btn-sm px-3"
                                            disabled="@isSavingRecap"
                                            @onclick="SaveMeetingNotesAsync">
                                        <i class="bi bi-save me-1"></i>@(isSavingRecap ? "Saving..." : "Save Meeting Notes")
                                    </button>
                                </div>

                                <hr class="my-3" />

                                <label class="form-label small fw-bold text-dark text-uppercase d-block mb-2">
                                    <i class="bi bi-check2-square me-1 text-success"></i>Action Items (Create Task in Calendar)
                                </label>

                                <div class="row g-2 mb-2">
                                    <div class="col-md-5">
                                        <input type="text"
                                               class="form-control form-control-sm bg-white"
                                               placeholder="Action item / follow-up task..."
                                               @bind="actionItemTitle" />
                                    </div>
                                    <div class="col-md-4">
                                        <select class="form-select form-select-sm bg-white" @bind="actionItemAssigneeId">
                                            <option value="">Assignee: Myself</option>
                                            @foreach (var emp in allEmployees)
                                            {
                                                <option value="@emp.Id">@(emp.Email ?? emp.UserName)</option>
                                            }
                                        </select>
                                    </div>
                                    <div class="col-md-3">
                                        <input type="datetime-local"
                                               class="form-control form-control-sm bg-white"
                                               @bind="actionItemDueDate" />
                                    </div>
                                </div>

                                <div class="d-flex justify-content-end mb-3">
                                    <button type="button"
                                            class="btn btn-success btn-sm px-3"
                                            disabled="@(isCreatingActionItem || string.IsNullOrWhiteSpace(actionItemTitle))"
                                            @onclick="AddActionItemAsTaskAsync">
                                        <i class="bi bi-plus-lg me-1"></i>@(isCreatingActionItem ? "Adding..." : "Add Action Item & Create Task")
                                    </button>
                                </div>

                                @if (meetingActionItems.Any())
                                {
                                    <div class="d-flex flex-column gap-2 mt-2">
                                        @foreach (var item in meetingActionItems)
                                        {
                                            <div class="d-flex justify-content-between align-items-center bg-white border rounded-2 px-3 py-2 small">
                                                <div class="me-2">
                                                    <div class="fw-semibold text-dark">@item.Title</div>
                                                    <div class="text-muted fs-9">
                                                        Assignee: <strong>@item.AssigneeName</strong> • Due: @item.DueDate.ToString("dd MMM yyyy, HH:mm", CultureInfo.InvariantCulture)
                                                    </div>
                                                </div>
                                                <span class="badge bg-primary flex-shrink-0">Task</span>
                                            </div>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <div class="text-muted small fst-italic">No action items recorded for this meeting yet.</div>
                                }
                            </div>
                        }

                        <div class="d-flex justify-content-between align-items-center pt-2 border-top">
                            <span class="small text-muted">
                                <i class="bi bi-shield-lock me-1"></i>
                                @(isOwner ? "Organizer (Full Control)" : "Invited Event")
                            </span>

                            <div class="d-flex gap-2">
                                @if (isOwner)
                                {
                                    <button class="btn btn-outline-primary btn-sm px-3" @onclick="() => StartMoveFromDetails(viewingEvent.Id)">
                                        <i class="bi bi-arrows-move me-1"></i> Move Event
                                    </button>
                                }
                                <button class="btn btn-secondary btn-sm px-3" @onclick="CloseDetailsModal">Close</button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- TEAMS STYLE TIME GRID CALENDAR -->
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white">
        <div class="calendar-header-grid border-bottom bg-light" style="grid-template-columns: 70px repeat(@displayedDays.Count, minmax(0, 1fr));">
            <div class="time-col-header border-end text-muted small fw-bold text-center py-3">Time</div>
            @foreach (var day in displayedDays)
            {
                var isToday = day.Date == DateTime.Today;
                <div class="day-col-header text-center py-2 border-end @(isToday ? "bg-primary text-white" : "")">
                    <span class="d-block text-uppercase fs-8 fw-semibold">@day.ToString("dddd", CultureInfo.InvariantCulture)</span>
                    <span class="fs-6 fw-bold">@day.ToString("dd MMM", CultureInfo.InvariantCulture)</span>
                </div>
            }
        </div>

        <div class="calendar-body-scroll">
            @{
                var staticNow = DateTime.Now;
            }
            @for (int hour = 8; hour <= 20; hour++)
            {
                var currentHour = hour;
                <div class="calendar-row border-bottom d-flex position-relative">
                    <div class="time-col border-end text-muted small text-center py-2 font-monospace">
                        @hour.ToString("00"):00
                    </div>

                    @foreach (var day in displayedDays)
                    {
                        var targetSlotTime = new DateTime(day.Year, day.Month, day.Day, hour, 0, 0);
                        var slotEvents = eventsList
                        .Where(e => e.StartTime.Date == day.Date && e.StartTime.Hour == hour &&
                        (string.IsNullOrEmpty(e.Category) || selectedCategories.Contains(e.Category)) &&
                        (!onlyEventsWithDeclinedInvitees || eventsWithDeclinedInvitees.Contains(GetEventSeriesOrSlotKey(e))))
                        .ToList();

                        var isTargetable = selectedEventId != Guid.Empty;
                        var isTodayCell = day.Date == DateTime.Today && staticNow.Hour == currentHour;

                        <div class="day-cell border-end p-1 position-relative @(isTargetable ? "slot-clickable" : "")"
                             @onclick="() => OnSlotClick(targetSlotTime)">

                            @if (isTodayCell)
                            {
                                var minuteOffset = (staticNow.Minute / 60.0) * 100;
                                <div class="current-time-line" style="top: @minuteOffset.ToString("0.##", CultureInfo.InvariantCulture)%;">
                                    <span class="time-ball"></span>
                                </div>
                            }

                            @foreach (var ev in slotEvents)
                            {
                                var isSelected = selectedEventId == ev.Id;
                                var isOwner = ev.CreatedById == Guid.Empty || ev.CreatedById.ToString() == currentEmployeeId;
                                var isPast = ev.EndTime < staticNow;
                                var rsvp = ExtractRsvpStatus(ev.Description);
                                var hasDeclined = isOwner && eventsWithDeclinedInvitees.Contains(GetEventSeriesOrSlotKey(ev));

                                <div class="p-1 px-2 mb-1 rounded-2 shadow-sm border-start border-3 event-item @(isPast ? "event-past bg-white opacity-75" : "bg-light") @(isSelected ? "event-selected" : "") @(rsvp == RsvpStatus.Declined ? "opacity-50" : "")"
                                     style="border-color: @(isPast ? "#cbd5e1" : GetPriorityColor(ev.Priority)) !important;"
                                     @onclick="() => SelectEvent(ev.Id, isOwner)"
                                     @onclick:stopPropagation="true"
                                     title="@($"{ev.Title} ({ev.StartTime:HH:mm} - {ev.EndTime:HH:mm}){(!isOwner ? $" • {rsvp}" : (hasDeclined ? " • Has declined invitee(s)" : ""))}")">

                                    <div class="d-flex justify-content-between align-items-start gap-1">
                                        <div class="event-content">
                                            <div class="text-dark fs-8 fw-semibold text-truncate @(isPast || rsvp == RsvpStatus.Declined ? "text-decoration-line-through text-muted" : "")">
                                                @if (IsMeetingCategory(ev.Category) && ev.IsOnline == true)
                                                {
                                                    <i class="bi bi-laptop text-info me-1" title="Online Meeting"></i>
                                                }
                                                @if (isPast)
                                                {
                                                    <i class="bi bi-check2-all text-success me-1" title="Completed"></i>
                                                }
                                                @if (isSelected)
                                                {
                                                    <i class="bi bi-cursor-fill text-primary me-1"></i>
                                                }
                                                @if (!isOwner)
                                                {
                                                    <i class="bi @GetRsvpIconClass(rsvp) me-1" title="RSVP: @rsvp"></i>
                                                }
                                                else if (hasDeclined)
                                                {
                                                    <i class="bi bi-person-x-fill text-danger me-1" title="Has declined invitee(s)"></i>
                                                }
                                                @ev.Title
                                            </div>
                                            <div class="fs-9 text-muted font-monospace text-truncate">
                                                @ev.StartTime.ToString("HH:mm") - @ev.EndTime.ToString("HH:mm")
                                                @if (!isOwner)
                                                {
                                                    <span>• @rsvp</span>
                                                }
                                                else if (hasDeclined)
                                                {
                                                    <span class="text-danger">• Declined</span>
                                                }
                                            </div>
                                        </div>

                                        <div class="d-flex gap-1 flex-shrink-0">
                                            <button type="button"
                                                    class="btn btn-sm btn-light border text-primary p-0 d-flex align-items-center justify-content-center event-action-btn"
                                                    @onclick="() => OpenDetailsModal(ev)"
                                                    @onclick:stopPropagation="true"
                                                    title="View details, notes & RSVP">
                                                <i class="bi bi-info-lg"></i>
                                            </button>

                                            @if (isOwner)
                                            {
                                                <button type="button"
                                                        class="btn btn-sm btn-light border text-danger p-0 d-flex align-items-center justify-content-center event-action-btn"
                                                        @onclick="() => RequestDeleteEvent(ev)"
                                                        @onclick:stopPropagation="true"
                                                        title="Delete event">
                                                    <i class="bi bi-x"></i>
                                                </button>
                                            }
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>

