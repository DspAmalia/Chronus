@page "/roles"
@using Microsoft.EntityFrameworkCore
@using Chronus.Models.MainModels
@using Chronus.Data
@inject IDbContextFactory<Chronus.Data.ChronusDbContext> DbFactory
@rendermode InteractiveServer

<PageTitle>Roles Management | Chronus</PageTitle>

<div class="container-fluid mt-4 px-4">
    <!-- Header Section -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3 mb-4">
        <div>
            <div class="d-flex align-items-center gap-2">
                <div class="rounded-3 text-white p-2 d-flex align-items-center justify-content-center shadow-sm" style="width: 44px; height: 44px; background: linear-gradient(135deg, #4f46e5, #6366f1);">
                    <i class="bi bi-shield-lock-fill fs-5"></i>
                </div>
                <div>
                    <h3 class="fw-bold text-dark mb-0">Roles & Permissions</h3>
                    <p class="text-muted small mb-0">Manage system roles, security tiers, and user access rights.</p>
                </div>
            </div>
        </div>

        <div class="d-flex align-items-center gap-2">
            <!-- View Switcher -->
            <div class="btn-group bg-light p-1 rounded-3 border" role="group">
                <button type="button" class="btn btn-sm @(isGridView ? "btn-white shadow-xs fw-semibold" : "text-muted")" @onclick="() => isGridView = true">
                    <i class="bi bi-grid-fill me-1"></i> Cards
                </button>
                <button type="button" class="btn btn-sm @(!isGridView ? "btn-white shadow-xs fw-semibold" : "text-muted")" @onclick="() => isGridView = false">
                    <i class="bi bi-list-task me-1"></i> List
                </button>
            </div>

            <a href="roles/create" class="btn text-white px-3 py-2 d-flex align-items-center gap-2 shadow-sm fw-medium rounded-3" style="background-color: #4f46e5; border: none;">
                <i class="bi bi-plus-lg"></i>
                <span>Add New Role</span>
            </a>
        </div>
    </div>

    <!-- Toolbar & Search -->
    <div class="card border-0 shadow-sm rounded-4 mb-4">
        <div class="card-body p-3">
            <div class="row g-3 align-items-center justify-content-between">
                <div class="col-12 col-md-5">
                    <div class="input-group">
                        <span class="input-group-text bg-transparent border-end-0 text-muted ps-3">
                            <i class="bi bi-search"></i>
                        </span>
                        <input type="text"
                               class="form-control border-start-0 bg-transparent py-2 shadow-none"
                               placeholder="Search by role name or description..."
                               @bind="searchTerm"
                               @bind:event="oninput" />
                    </div>
                </div>
                <div class="col-auto text-muted small d-flex align-items-center gap-3">
                    <span>Active Roles: <strong class="text-dark">@rolesList.Count</strong></span>
                    <span class="border-end py-2"></span>
                    <span>Filtered: <strong style="color: #4f46e5;">@FilteredRoles.Count()</strong></span>
                </div>
            </div>
        </div>
    </div>

    <!-- RENDERIZARE CONDIȚIONALĂ corectată -->
    @if (isGridView)
    {
        @if (!FilteredRoles.Any())
        {
            <div class="text-center py-5 bg-white rounded-4 shadow-sm border">
                <i class="bi bi-shield-x text-muted display-4"></i>
                <h5 class="mt-3 text-dark fw-semibold">No roles found</h5>
                <p class="text-muted small">Try adjusting your search filter or create a new role.</p>
            </div>
        }
        else
        {
            <div class="row g-4">
                @foreach (var role in FilteredRoles)
                {
                    <div class="col-12 col-md-6 col-xl-4">
                        <div class="card border-0 shadow-sm rounded-4 h-100 card-hover transition-all position-relative overflow-hidden" style="border: 1px solid #eef2f6 !important;">
                            <div class="card-body p-4 d-flex flex-column justify-content-between">
                                <div>
                                    <!-- Card Header: Title & Badge -->
                                    <div class="d-flex justify-content-between align-items-start mb-3">
                                        <div class="d-flex align-items-center gap-3">
                                            <div class="rounded-circle d-flex align-items-center justify-content-center fw-bold"
                                                 style="width: 48px; height: 48px; background-color: #eef2ff; color: #4f46e5; font-size: 1.1rem;">
                                                @role.Name.Substring(0, Math.Min(2, role.Name.Length)).ToUpper()
                                            </div>
                                            <div>
                                                <h5 class="fw-bold text-dark mb-0">@role.Name</h5>
                                                <span class="badge bg-light text-muted border font-monospace mt-1" style="font-size: 0.7rem;">
                                                    @role.Id.ToString().Substring(0, 8)
                                                </span>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Description -->
                                    <p class="text-secondary small mb-4 line-clamp-2" style="min-height: 40px;">
                                        @(string.IsNullOrWhiteSpace(role.Description) ? "No description provided for this role." : role.Description)
                                    </p>
                                </div>

                                <div>
                                    <hr class="my-3 opacity-10" />

                                    <!-- Card Footer: Stats & Actions -->
                                    <div class="d-flex align-items-center justify-content-between">
                                        <div class="d-flex align-items-center gap-1 text-muted small">
                                            <i class="bi bi-people-fill" style="color: #6366f1;"></i>
                                            <span class="fw-semibold text-dark ms-1">@role.Employees.Count</span>
                                            <span>@(role.Employees.Count == 1 ? "member" : "members")</span>
                                        </div>

                                        <div class="d-flex align-items-center gap-2">
                                            <a href="@($"roles/details?id={role.Id}")" class="btn btn-icon btn-light rounded-circle shadow-xs" title="View Details">
                                                <i class="bi bi-eye text-secondary"></i>
                                            </a>
                                            <a href="@($"roles/edit?id={role.Id}")" class="btn btn-icon btn-light rounded-circle shadow-xs" title="Edit Role">
                                                <i class="bi bi-pencil text-warning"></i>
                                            </a>
                                            <a href="@($"roles/delete?id={role.Id}")" class="btn btn-icon btn-light rounded-circle shadow-xs" title="Delete Role">
                                                <i class="bi bi-trash3 text-danger"></i>
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    }
    else
    {
        <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-light text-uppercase fs-8 text-muted fw-bold">
                        <tr>
                            <th class="ps-4 py-3">Role</th>
                            <th class="py-3">Description</th>
                            <th class="py-3">Assigned Users</th>
                            <th class="pe-4 py-3 text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!FilteredRoles.Any())
                        {
                            <tr>
                                <td colspan="4" class="text-center py-4 text-muted">No roles found.</td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var role in FilteredRoles)
                            {
                                <tr>
                                    <td class="ps-4 py-3">
                                        <div class="d-flex align-items-center gap-3">
                                            <div class="rounded-circle d-flex align-items-center justify-content-center fw-bold"
                                                 style="width: 38px; height: 38px; background-color: #eef2ff; color: #4f46e5; font-size: 0.9rem;">
                                                @role.Name.Substring(0, Math.Min(2, role.Name.Length)).ToUpper()
                                            </div>
                                            <div>
                                                <span class="fw-bold text-dark d-block">@role.Name</span>
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        <span class="text-secondary small">
                                            @(string.IsNullOrWhiteSpace(role.Description) ? "-" : role.Description)
                                        </span>
                                    </td>
                                    <td>
                                        <span class="badge rounded-pill px-3 py-2 border" style="background-color: #eef2ff; color: #4f46e5; border-color: #c7d2fe !important;">
                                            <i class="bi bi-people-fill me-1"></i> @role.Employees.Count Users
                                        </span>
                                    </td>
                                    <td class="pe-4 text-end">
                                        <div class="d-inline-flex gap-2">
                                            <a href="@($"roles/details?id={role.Id}")" class="btn btn-sm btn-light border fw-medium px-3">Details</a>
                                            <a href="@($"roles/edit?id={role.Id}")" class="btn btn-sm btn-light border text-warning fw-medium px-3">Edit</a>
                                            <a href="@($"roles/delete?id={role.Id}")" class="btn btn-sm btn-light border text-danger fw-medium px-3">Delete</a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

<style>
    .card-hover {
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

        .card-hover:hover {
            transform: translateY(-3px);
            box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.08) !important;
        }

    .btn-icon {
        width: 34px;
        height: 34px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 0;
    }

    .btn-white {
        background-color: #ffffff;
        color: #1e293b;
    }

    .line-clamp-2 {
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .fs-8 {
        font-size: 0.75rem;
    }

    .shadow-xs {
        box-shadow: 0 1px 2px 0 rgba(0, 0, 0, 0.05);
    }
</style>

@code {
    private List<Role> rolesList = new();
    private string searchTerm = string.Empty;
    private bool isGridView = true;

    protected override async Task OnInitializedAsync()
    {
        await LoadRolesAsync();
    }

    private async Task LoadRolesAsync()
    {
        using var db = await DbFactory.CreateDbContextAsync();
        rolesList = await db.Roles
            .Include(r => r.Employees)
            .ToListAsync();
    }

    private IEnumerable<Role> FilteredRoles
    {
        get
        {
            if (string.IsNullOrWhiteSpace(searchTerm))
                return rolesList;

            return rolesList.Where(r => r.Name.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ||
                                       (r.Description != null && r.Description.Contains(searchTerm, StringComparison.OrdinalIgnoreCase)));
        }
    }
}