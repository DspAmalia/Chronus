@page "/roles/details"
@using Microsoft.EntityFrameworkCore
@using Chronus.Models.MainModels
@inject IDbContextFactory<Chronus.Data.ChronusDbContext> DbFactory
@inject NavigationManager NavigationManager
@rendermode InteractiveServer

<PageTitle>Role Details | Chronus</PageTitle>

<div class="container-fluid mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <!-- Header Navigare -->
            <div class="mb-3">
                <a href="/roles" class="text-decoration-none text-muted small">
                    <i class="bi bi-arrow-left me-1"></i> Back to Roles List
                </a>
            </div>

            <!-- Card Principal -->
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white py-3 border-bottom-0">
                    <div class="d-flex align-items-center justify-content-between">
                        <div class="d-flex align-items-center">
                            <div class="rounded-circle bg-info bg-opacity-10 p-3 me-3 text-info">
                                <i class="bi bi-shield-check fs-3"></i>
                            </div>
                            <div>
                                <h4 class="mb-0 fw-bold">Role Details</h4>
                                <p class="text-muted small mb-0">Overview of permissions and assigned members.</p>
                            </div>
                        </div>
                        @if (role is not null)
                        {
                            <a href="@($"/roles/edit?id={role.Id}")" class="btn btn-outline-primary btn-sm d-flex align-items-center gap-1">
                                <i class="bi bi-pencil"></i> Edit Role
                            </a>
                        }
                    </div>
                </div>

                <div class="card-body p-4">
                    @if (role is null)
                    {
                        <div class="d-flex justify-content-center py-4">
                            <div class="spinner-border text-primary" role="status">
                                <span class="visually-hidden">Loading...</span>
                            </div>
                        </div>
                    }
                    else
                    {
                        <!-- Date Generale -->
                        <div class="bg-light p-3 rounded mb-4 border">
                            <div class="row mb-3 align-items-center">
                                <div class="col-sm-4 text-muted fw-semibold">Role Name:</div>
                                <div class="col-sm-8 fs-5 fw-bold text-dark">
                                    @role.Name
                                    <span class="badge bg-secondary fs-6 ms-2">ID: @role.Id.ToString().Substring(0, 8)...</span>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-sm-4 text-muted fw-semibold">Description:</div>
                                <div class="col-sm-8 text-secondary">
                                    @(string.IsNullOrWhiteSpace(role.Description) ? "No description provided." : role.Description)
                                </div>
                            </div>
                        </div>

                        <!-- Membri Asociați (Angajați cu acest rol) -->
                        <div class="mb-4">
                            <h6 class="fw-bold mb-3 d-flex align-items-center justify-content-between">
                                <span><i class="bi bi-people me-2"></i>Assigned Employees</span>
                                <span class="badge bg-primary rounded-pill">@role.Employees.Count</span>
                            </h6>

                            @if (!role.Employees.Any())
                            {
                                <div class="text-center py-3 border rounded bg-white text-muted small">
                                    No employees currently assigned to this role.
                                </div>
                            }
                            else
                            {
                                <ul class="list-group list-group-flush border rounded">
                                    @foreach (var emp in role.Employees)
                                    {
                                        <li class="list-group-item d-flex justify-content-between align-items-center">
                                            <div>
                                                <strong>@emp.FirstName @emp.LastName</strong>
                                                <div class="text-muted small">@emp.Email</div>
                                            </div>
                                            <span class="badge @(emp.IsActive ? "bg-success" : "bg-danger")">
                                                @(emp.IsActive ? "Active" : "Inactive")
                                            </span>
                                        </li>
                                    }
                                </ul>
                            }
                        </div>

                        <!-- Subsol Acțiuni -->
                        <div class="d-flex justify-content-between align-items-center pt-3 border-top">
                            <a href="/roles" class="btn btn-light px-4">Back to List</a>
                            <a href="@($"/roles/delete?id={role.Id}")" class="btn btn-outline-danger px-3">
                                <i class="bi bi-trash me-1"></i> Delete
                            </a>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private Role? role;

    [SupplyParameterFromQuery]
    private Guid Id { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = await DbFactory.CreateDbContextAsync();

        // Include angajații asociați pentru a-i afișa în pagină
        role = await context.Roles
            .Include(r => r.Employees)
            .FirstOrDefaultAsync(m => m.Id == Id);

        if (role is null)
        {
            NavigationManager.NavigateTo("/roles");
        }
    }
}