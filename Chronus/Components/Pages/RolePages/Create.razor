@page "/roles/create"
@using Microsoft.EntityFrameworkCore
@using Chronus.Models.MainModels
@inject IDbContextFactory<Chronus.Data.ChronusDbContext> DbFactory
@inject NavigationManager NavigationManager
@rendermode InteractiveServer

<PageTitle>Create Role | Chronus</PageTitle>

<div class="container-fluid mt-4">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <!-- Header Navigare -->
            <div class="mb-3">
                <a href="/roles" class="text-decoration-none text-muted small">
                    <i class="bi bi-arrow-left me-1"></i> Back to Roles List
                </a>
            </div>

            <!-- Card Principal -->
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white py-3 border-bottom-0">
                    <div class="d-flex align-items-center">
                        <div class="rounded-circle bg-primary bg-opacity-10 p-3 me-3 text-primary">
                            <i class="bi bi-shield-plus fs-4"></i>
                        </div>
                        <div>
                            <h4 class="mb-0 fw-bold">Create New Role</h4>
                            <p class="text-muted small mb-0">Define permissions and access tiers for system users.</p>
                        </div>
                    </div>
                </div>

                <div class="card-body p-4">
                    <EditForm Model="Role" OnValidSubmit="AddRole">
                        <DataAnnotationsValidator />
                        <ValidationSummary class="alert alert-danger p-2 mb-3 small" role="alert" />

                        <!-- Name Input -->
                        <div class="mb-3">
                            <label for="name" class="form-label fw-semibold">Role Name <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0"><i class="bi bi-tag text-muted"></i></span>
                                <InputText id="name" @bind-Value="Role.Name" class="form-control border-start-0 ps-0" placeholder="e.g. Team Lead, HR Manager" />
                            </div>
                            <ValidationMessage For="() => Role.Name" class="text-danger small mt-1" />
                        </div>

                        <!-- Description Input -->
                        <div class="mb-4">
                            <label for="description" class="form-label fw-semibold">Description</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0"><i class="bi bi-card-text text-muted"></i></span>
                                <InputText id="description" @bind-Value="Role.Description" class="form-control border-start-0 ps-0" placeholder="Short summary of access rights..." />
                            </div>
                            <ValidationMessage For="() => Role.Description" class="text-danger small mt-1" />
                        </div>

                        <!-- Actions -->
                        <div class="d-flex justify-content-end gap-2 pt-2 border-top">
                            <a href="/roles" class="btn btn-light px-4">Cancel</a>
                            <button type="submit" class="btn btn-primary px-4 d-flex align-items-center gap-2" disabled="@isSubmitting">
                                @if (isSubmitting)
                                {
                                    <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                                    <span>Saving...</span>
                                }
                                else
                                {
                                    <i class="bi bi-check-circle-fill"></i>
                                    <span>Save Role</span>
                                }
                            </button>
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private Role Role { get; set; } = new();
    private bool isSubmitting = false;

    private async Task AddRole()
    {
        if (isSubmitting) return;
        isSubmitting = true;

        try
        {
            using var context = await DbFactory.CreateDbContextAsync();
            context.Roles.Add(Role);
            await context.SaveChangesAsync();

            NavigationManager.NavigateTo("/roles");
        }
        finally
        {
            isSubmitting = false;
        }
    }
}